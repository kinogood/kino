DEFINE _SET_CON1.
  CLEAR : &1.
  IF &3 IS NOT INITIAL.
    &2 = &3.
    COLLECT &1.
  ENDIF.
END-OF-DEFINITION.

DEFINE _SET_CON2.
  CLEAR : &1.
  IF &4 IS NOT INITIAL.
    &2 = &4.
    &3 = &5.
    COLLECT &1.
  ENDIF.
END-OF-DEFINITION.

