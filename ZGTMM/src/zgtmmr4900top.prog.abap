*&---------------------------------------------------------------------*
*& Include ZGTMMR4900TOP
*&---------------------------------------------------------------------*

DATA : BEGIN OF GS_IFNO,
         KIND LIKE ZGTPPT1010-MODULE_KIND,
         KEY  LIKE ZGTPPT1010-FLD_01,
         TEXT LIKE ZGTPPT1010-FLD_02,
         TYPE LIKE ZGTPPT1010-FLD_03,
         PROG LIKE ZGTPPT1010-FLD_04,
         VIEW LIKE ZGTPPT1010-FLD_05,
       END   OF GS_IFNO.
DATA : GT_IFNO LIKE SORTED TABLE OF GS_IFNO
                WITH NON-UNIQUE KEY KIND KEY.

DATA : GT_SEL LIKE RSPARAMS OCCURS 0 WITH HEADER LINE.

DATA : GV_CNT TYPE I.

DATA : GV_OKCODE LIKE SY-UCOMM.

DATA : GV_REF.

FIELD-SYMBOLS : <GS_LIST>,
                <GT_LIST> TYPE STANDARD TABLE.


CONSTANTS : GC_A(1)    VALUE 'A',
            GC_D(1)    VALUE 'D',
            GC_E(1)    VALUE 'E',
            GC_I(1)    VALUE 'I',
            GC_S(1)    VALUE 'S',
            GC_X(1)    VALUE 'X',
            GC_BT(2)   VALUE 'BT',
            GC_EQ(2)   VALUE 'EQ',
            GC_MM(2)   VALUE 'MM',
            GC_PP(2)   VALUE 'PP',
            GC_0010(4) VALUE '0010'.


*----------------------------------------------------------------------*
* SELECTION-SCREEN
*----------------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK BK1 WITH FRAME TITLE TEXT-S01.
  PARAMETERS : P_IFNUM TYPE ZGTE_FLDVAL AS LISTBOX VISIBLE LENGTH 25
                                        USER-COMMAND IFN.
SELECTION-SCREEN END   OF BLOCK BK1.

SELECTION-SCREEN BEGIN OF BLOCK BK2 WITH FRAME TITLE TEXT-S02.
  PARAMETERS     : P_IFSYT TYPE ZGTE_FLDVAL AS LISTBOX VISIBLE LENGTH 17. "I/F 시스템
  SELECT-OPTIONS : S_IFDAT FOR SY-DATLO OBLIGATORY NO-EXTENSION.          "I/F Date
SELECTION-SCREEN END   OF BLOCK BK2.

SELECTION-SCREEN BEGIN OF BLOCK BK3 WITH FRAME TITLE TEXT-S03.
  SELECTION-SCREEN BEGIN OF LINE.
    PARAMETERS : P_ALL RADIOBUTTON GROUP GR1
                             USER-COMMAND EXE DEFAULT 'X'.
    SELECTION-SCREEN COMMENT (15) TEXT-R01 FOR FIELD P_ALL.

    SELECTION-SCREEN POSITION 32.
    PARAMETERS : P_SUC RADIOBUTTON GROUP GR1.
    SELECTION-SCREEN COMMENT (15) TEXT-R02 FOR FIELD P_SUC.

    SELECTION-SCREEN POSITION 64.
    PARAMETERS : P_ERR RADIOBUTTON GROUP GR1.
    SELECTION-SCREEN COMMENT (15) TEXT-R03 FOR FIELD P_ERR.
  SELECTION-SCREEN END   OF LINE.
SELECTION-SCREEN END   OF BLOCK BK3.
