FUNCTION-POOL ZGTMM62                   . "MESSAGE-ID ...


DATA : GV_ZSYSTEM_ID TYPE ZGTETARGET,
       GV_ZWERKS     TYPE EWERK,
*      GV_ZTABLE     TYPE	CHAR20,
       GV_JOB_NO     TYPE ZGTE_BD_JOBNO,
       GV_CANCEL     TYPE CHAR1.

DATA : GV_RST TYPE ZO_RESULT,
       GV_MSG TYPE ZO_MESSAGE.

DATA : BEGIN OF GT_CPR OCCURS 0,
         JOB_NO    LIKE ZGTMMT6210-JOB_NO,
         JOBLS     LIKE ZGTMMT6210-JOBLS,
         DOCNO(10),
       END   OF GT_CPR.

DATA : GT_CPO LIKE GT_CPR OCCURS 0 WITH HEADER LINE.

DATA : GT_DATA LIKE ZGTEDT2132 OCCURS 0 WITH HEADER LINE,
       GT_6210 LIKE ZGTMMT6210 OCCURS 0 WITH HEADER LINE,
       GT_6211 LIKE ZGTMMT6211 OCCURS 0 WITH HEADER LINE.

DATA : BEGIN OF GT_MES OCCURS 0,
         MES_REQ LIKE ZGTMMT6210-MES_REQ,
         MES_SEQ LIKE ZGTMMT6210-MES_SEQ,
         JOBLS   LIKE ZGTMMT6210-JOBLS,
         JOB_NO  LIKE ZGTMMT6210-JOB_NO,
       END   OF GT_MES.


DATA : GV_ERR.

DATA : GS_CREA LIKE ZGTMMS0001,
       GS_CHNG LIKE ZGTMMS0002.


CONSTANTS : GC_E(1)           VALUE 'E',
            GC_S(1)           VALUE 'S',
            GC_X(1)           VALUE 'X',
            GC_53(2)          VALUE '53',
            GC_ZGTMMT6210(10) VALUE 'ZGTMMT6210',
            GC_ZGTMMT6211(10) VALUE 'ZGTMMT6211'.
