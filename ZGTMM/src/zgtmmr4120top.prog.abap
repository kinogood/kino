         VERPR        TYPE ZGTMM_CV_SCSTOCKITEM_SUM-VERPR,
         STPRS        TYPE ZGTMM_CV_SCSTOCKITEM_SUM-STPRS,
         PEINH        TYPE ZGTMM_CV_SCSTOCKITEM_SUM-PEINH,
         LBLAB        TYPE ZGTMM_CV_SCSTOCKITEM_SUM-LBLAB,
         MEINS        TYPE ZGTMM_CV_SCSTOCKITEM_SUM-MEINS,
         TOTALSCVALUE TYPE ZGTMM_CV_SCSTOCKITEM_SUM-TOTALSCVALUE,
         WAERS        TYPE ZGTMM_CV_SCSTOCKITEM_SUM-WAERS,
