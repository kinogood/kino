*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZGTMMV4115......................................*
FORM GET_DATA_ZGTMMV4115.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZGTMMT4115 WHERE
(VIM_WHERETAB) .
    CLEAR ZGTMMV4115 .
ZGTMMV4115-MANDT =
ZGTMMT4115-MANDT .
ZGTMMV4115-PERSNUMBER =
ZGTMMT4115-PERSNUMBER .
ZGTMMV4115-MAIL =
ZGTMMT4115-MAIL .
<VIM_TOTAL_STRUC> = ZGTMMV4115.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZGTMMV4115 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZGTMMV4115.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZGTMMV4115-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZGTMMT4115 WHERE
  PERSNUMBER = ZGTMMV4115-PERSNUMBER AND
  MAIL = ZGTMMV4115-MAIL .
    IF SY-SUBRC = 0.
    DELETE ZGTMMT4115 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZGTMMT4115 WHERE
  PERSNUMBER = ZGTMMV4115-PERSNUMBER AND
  MAIL = ZGTMMV4115-MAIL .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZGTMMT4115.
    ENDIF.
ZGTMMT4115-MANDT =
ZGTMMV4115-MANDT .
ZGTMMT4115-PERSNUMBER =
ZGTMMV4115-PERSNUMBER .
ZGTMMT4115-MAIL =
ZGTMMV4115-MAIL .
    IF SY-SUBRC = 0.
    UPDATE ZGTMMT4115 ##WARN_OK.
    ELSE.
    INSERT ZGTMMT4115 .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZGTMMV4115-UPD_FLAG,
STATUS_ZGTMMV4115-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
*---------------------------------------------------------------------*
FORM READ_SINGLE_ENTRY_ZGTMMV4115.
  SELECT SINGLE * FROM ZGTMMT4115 WHERE
PERSNUMBER = ZGTMMV4115-PERSNUMBER AND
MAIL = ZGTMMV4115-MAIL .
ZGTMMV4115-MANDT =
ZGTMMT4115-MANDT .
ZGTMMV4115-PERSNUMBER =
ZGTMMT4115-PERSNUMBER .
ZGTMMV4115-MAIL =
ZGTMMT4115-MAIL .
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZGTMMV4115 USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZGTMMV4115-PERSNUMBER TO
ZGTMMT4115-PERSNUMBER .
MOVE ZGTMMV4115-MAIL TO
ZGTMMT4115-MAIL .
MOVE ZGTMMV4115-MANDT TO
ZGTMMT4115-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZGTMMT4115'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZGTMMT4115 TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZGTMMT4115'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
