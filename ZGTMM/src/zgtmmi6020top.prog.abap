            GC_ROH1(4)         VALUE 'ROH1',
            GC_ROH2(4)         VALUE 'ROH2',
            GC_0001(4)         VALUE '0001',
            GC_0010(4)         VALUE '0010',
            GC_1100(4)         VALUE '1100',
