TABLES : MARA, MKPF.


DATA : GV_CDATE LIKE SY-DATLO.

DATA : GV_CNT TYPE I.

DATA : GV_PTYPE,
       GV_VALUE TYPE SALK3.

DATA : GT_OT LIKE ZGTMMS0004 OCCURS 0 WITH HEADER LINE.

DATA : BEGIN OF GT_LIST OCCURS 0,
         WERKS     LIKE ZGTMMS0004-WERKS,     "플랜트
         WERKS_N   LIKE ZGTMMS0004-WERKS_N,   "플랜트명
         MATNR     LIKE ZGTMMS0004-MATNR,     "자재
         MATNR_N   LIKE ZGTMMS0004-MATNR_N,   "자재명
         APLFZ     LIKE ZGTMMS0004-APLFZ,     "L/T(일수)
         FACTOR    LIKE ZGTMMS0004-FACTOR,    "K
         REQ_DAILY LIKE ZGTMMS0004-REQ_DAILY, "일소요량
         SAFTYQTY  LIKE ZGTMMS0004-SAFTYQTY,  "안전재고
         PSTOCK    LIKE ZGTMMS0004-PSTOCK,    "적정재고
         UNQTY     LIKE ZGTMMS0004-UNQTY,     "창고재고
         BONDEDQTY LIKE ZGTMMS0004-BONDEDQTY, "보세재고
         TOTALQTY  LIKE ZGTMMS0004-PSTOCK,    "재고합계
         MEINS     LIKE ZGTMMS0004-MEINS,     "단위
         STOCKVAL  LIKE ZGTMMS0004-STOCKVAL,  "현재고액
         WAERS     LIKE ZGTMMS0004-WAERS,     "통화
         DIFF      LIKE ZGTMMS0004-PSTOCK,    "적정재고대비
         GIQTY     LIKE ZGTMMS0004-GIQTY,     "총 출고수량
         DAYC      LIKE ZGTMMS0004-DAYC,      "총 소요일
         F1        LIKE ZGTMMS0004-F1,        "FACTOR1
         WEEKC     LIKE ZGTMMS0004-WEEKC,     "Period(W)
         SUQTY     LIKE ZGTMMS0004-SUQTY,     "1차 적정재고
         LASTAVG   LIKE ZGTMMS0004-LASTAVG,   "FACTOR2
       END   OF GT_LIST.


DATA : GV_OKCODE LIKE SY-UCOMM.


CONSTANTS : GC_A(1)    VALUE 'A',
            GC_D(1)    VALUE 'D',
            GC_E(1)    VALUE 'E',
            GC_I(1)    VALUE 'I',
            GC_S(1)    VALUE 'S',
            GC_W(1)    VALUE 'W',
            GC_X(1)    VALUE 'X',
            GC_0(1)    VALUE '0',
            GC_9(1)    VALUE '9',
            GC_BT(2)   VALUE 'BT',
            GC_GE(2)   VALUE 'GE',
            GC_CAL(3)  VALUE 'CAL',
            GC_C300(4) VALUE 'C300',
            GC_C410(4) VALUE 'C410',
            GC_C500(4) VALUE 'C500',
            GC_C710(4) VALUE 'C710'.


DEFINE _CALC_DATE.
  CLEAR : GV_CDATE.
  CALL FUNCTION 'RP_CALC_DATE_IN_INTERVAL'
    EXPORTING
      DATE      = &1
      DAYS      = &2
      MONTHS    = &3
      SIGNUM    = &4
      YEARS     = &5
    IMPORTING
      CALC_DATE = GV_CDATE.
END-OF-DEFINITION.


