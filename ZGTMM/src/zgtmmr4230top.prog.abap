TABLES : MSEG, SSCRFIELDS.


DATA : GS_FKEY TYPE SMP_DYNTXT.

DATA : GV_CDATE LIKE SY-DATLO.

DATA : BEGIN OF GT_WERKS OCCURS 0,
         WERKS LIKE T001W-WERKS,
       END   OF GT_WERKS.


DATA : GS_COM TYPE ZGTMMS0008.

DATA : BEGIN OF GT_WSTK OCCURS 0.
         INCLUDE STRUCTURE ZGTMMS0008.
         INCLUDE STRUCTURE ZGTMMS0006.
DATA : END   OF GT_WSTK.

DATA : BEGIN OF GT_DSTK OCCURS 0.
         INCLUDE STRUCTURE ZGTMMS0008.
         INCLUDE STRUCTURE ZGTMMS0007.
DATA : END   OF GT_DSTK.

DATA : GT_4220 LIKE ZGTMMT4220 OCCURS 0 WITH HEADER LINE,
       GT_4221 LIKE ZGTMMT4221 OCCURS 0 WITH HEADER LINE,
       GT_4222 LIKE ZGTMMT4222 OCCURS 0 WITH HEADER LINE,
       GT_4223 LIKE ZGTMMT4223 OCCURS 0 WITH HEADER LINE.

DATA : GS_CREA LIKE ZGTMMS0001,
       GS_CHNG LIKE ZGTMMS0002.


DATA : GV_OKCODE LIKE SY-UCOMM,
       GV_TITLE  TYPE STRING.

DATA : GV_CNT TYPE I.

DATA : GV_ERR,
       GV_REF.


CONSTANTS : GC_A(1)    VALUE 'A',
            GC_D(1)    VALUE 'D',
            GC_I(1)    VALUE 'I',
            GC_W(1)    VALUE 'W',
            GC_X(1)    VALUE 'X',
            GC_BT(2)   VALUE 'BT',
            GC_1000(4) VALUE '1000',
            GC_C300(4) VALUE 'C300',
            GC_C500(4) VALUE 'C500',
            GC_C710(4) VALUE 'C710'.


DEFINE _CALC_DATE.
  CLEAR : GV_CDATE.
  CALL FUNCTION 'RP_CALC_DATE_IN_INTERVAL'
    EXPORTING
      DATE      = &1
      DAYS      = &2
      MONTHS    = &3
      SIGNUM    = &4
      YEARS     = &5
    IMPORTING
      CALC_DATE = GV_CDATE.
END-OF-DEFINITION.


