TABLES : T001W, EKKO.


RANGES : GR_GR1   FOR SCREEN-GROUP1,
         GR_SNM   FOR SCREEN-NAME,
         GR_EBELN FOR EKKO-EBELN.


DATA : BEGIN OF GT_IFNO OCCURS 0,
         KEY  LIKE ZGTPPT1010-FLD_01,
         TEXT LIKE ZGTPPT1010-FLD_02,
       END   OF GT_IFNO.

DATA : BEGIN OF GS_MST,
         TYPE LIKE ZGTPPT1010-FLD_03,
         PROG LIKE ZGTPPT1010-FLD_04,
         VIEW LIKE ZGTPPT1010-FLD_05,
       END   OF GS_MST.

DATA : GT_LHDR TYPE ZGTMM_CV_PO_IF_LOG_L OCCURS 0 WITH HEADER LINE,
       GT_LITM TYPE ZGTMMT9021           OCCURS 0 WITH HEADER LINE,
       GT_LMAT TYPE ZGTMMT9022           OCCURS 0 WITH HEADER LINE. "사용?

DATA : GT_PCHG TYPE ZGTMM_CV_CHANGEDPO OCCURS 0 WITH HEADER LINE,
       GS_PCHG TYPE ZGTMM_CV_CHANGEDPO.

DATA : BEGIN OF GT_LFA1 OCCURS 0,
         LIFNR LIKE LFA1-LIFNR,
         KTOKK LIKE LFA1-KTOKK,
       END   OF GT_LFA1.

DATA : BEGIN OF GT_SHDR OCCURS 0.
DATA :  CHANGENR LIKE ZGTMMT9020-CHANGENR.
        INCLUDE STRUCTURE ZGTMMSIF0002.
DATA : END   OF GT_SHDR.

DATA : GT_SITM LIKE SORTED TABLE OF ZGTMMSIF0003
                WITH NON-UNIQUE KEY EBELN EBELP,
       GT_SMAT LIKE SORTED TABLE OF ZGTMMSIF0004
                WITH NON-UNIQUE KEY EBELN EBELP MATNR. "사용? STATU 추가해야 하나?
DATA : GS_SITM LIKE ZGTMMSIF0003,
       GS_SMAT LIKE ZGTMMSIF0004.

DATA : GT_XHDR LIKE TABLE OF GT_SHDR,
       GT_XITM LIKE ZGTMMSIF0003 OCCURS 0 WITH HEADER LINE,
       GT_XMAT LIKE ZGTMMSIF0004 OCCURS 0 WITH HEADER LINE.

DATA : GT_TITM LIKE ZGTMMSIF0003 OCCURS 0 WITH HEADER LINE,
       GT_TMAT LIKE ZGTMMSIF0004 OCCURS 0 WITH HEADER LINE.

DATA : GT_F002 LIKE ZGTMMSIF0002 OCCURS 0 WITH HEADER LINE,
       GT_F003 LIKE ZGTMMSIF0003 OCCURS 0 WITH HEADER LINE,
       GT_F004 LIKE ZGTMMSIF0004 OCCURS 0 WITH HEADER LINE.

DATA : GS_9000 LIKE ZGTMMT9000,
       GT_9020 LIKE ZGTMMT9020 OCCURS 0 WITH HEADER LINE,
       GT_9021 LIKE ZGTMMT9021 OCCURS 0 WITH HEADER LINE,
       GT_9022 LIKE ZGTMMT9022 OCCURS 0 WITH HEADER LINE.


DATA : GV_ERR,
       GV_ANS,
       GV_MSG(100),
       GV_CNT TYPE I.

DATA : GV_HNAME TYPE TABNAME,
       GV_INAME TYPE TABNAME.

DATA : GV_OKCODE LIKE SY-UCOMM.

DATA : GV_SEND(10),
       GV_REF.


FIELD-SYMBOLS : <GV_EBELN>,
                <GS_LIST>,
                <GT_HLIST> TYPE STANDARD TABLE,
                <GT_ILIST> TYPE STANDARD TABLE.


CONSTANTS : GC_A(1)             VALUE 'A',
            GC_C(1)             VALUE 'C',
            GC_D(1)             VALUE 'D',
            GC_E(1)             VALUE 'E',
            GC_H(1)             VALUE 'H',
            GC_I(1)             VALUE 'I',
            GC_L(1)             VALUE 'L',
            GC_O(1)             VALUE 'O',
            GC_S(1)             VALUE 'S',
            GC_X(1)             VALUE 'X',
            GC_1(1)             VALUE '1',
            GC_3(1)             VALUE '3',
            GC_BT(2)            VALUE 'BT',
            GC_EQ(2)            VALUE 'EQ',
            GC_MM(2)            VALUE 'MM',
            GC_PP(2)            VALUE 'PP',
            GC_02(2)            VALUE '02',
