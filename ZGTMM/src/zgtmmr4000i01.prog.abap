MODULE EXIT INPUT.

  CASE GV_OKCODE.
    WHEN 'EXIT'. "OR 'CANC'.
      PERFORM CHECK_EXIT USING 'C'.

  ENDCASE.

  CLEAR : GV_OKCODE.

ENDMODULE.
