FORM SET_ZSEQ_CHECK_1023.
* ZGTMMV1023 MAINTENANCE VIEW - EVENT FORM (05번 이벤트: 행 추가 시점)
  DATA: LV_WERKS TYPE ZGTMMT1023-WERKS,
        LV_LIFNR TYPE ZGTMMT1023-LIFNR,
        LV_ZSEQ  TYPE ZGTMMT1023-ZSEQ.

  FIELD-SYMBOLS: <FS_FIELD> TYPE any.

  " 1. 현재 추가 중인 행에서 키 필드(WERKS, LIFNR) 값 추출
  ASSIGN COMPONENT 'WERKS' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
  IF SY-SUBRC = 0. LV_WERKS = <FS_FIELD>. ENDIF.

  ASSIGN COMPONENT 'LIFNR' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
  IF SY-SUBRC = 0. LV_LIFNR = <FS_FIELD>. ENDIF.

  ASSIGN COMPONENT 'NAME1' OF STRUCTURE <VIM_TOTAL_STRUC> TO FIELD-SYMBOL(<NAME1>).
  IF SY-SUBRC = 0.
    SELECT SINGLE NAME1
      FROM LFA1
      WHERE LIFNR = @LV_LIFNR
      INTO @<NAME1>.
  ENDIF.

  " 2. DB에서 현재 마지막 순번 확인
  SELECT MAX( ZSEQ )
    FROM ZGTMMT1023
   WHERE WERKS = @LV_WERKS
     AND LIFNR = @LV_LIFNR
    INTO @LV_ZSEQ.

  " 3. 순번 필드(ZSEQ)에 임시 번호 주입하여 표준 중복 체크 우회
  ASSIGN COMPONENT 'ZSEQ' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
  IF SY-SUBRC = 0.
    <FS_FIELD> = LV_ZSEQ + 1.
  ENDIF.

ENDFORM.

FORM SET_ZSEQ_ZGTMMT1023.

  FIELD-SYMBOLS: <FS_FIELD> TYPE ANY.

  LOOP AT TOTAL.
    IF <ACTION> = 'N' OR <ACTION> = 'U'.

      IF <ACTION> = 'N'.
        ASSIGN COMPONENT 'WERKS' OF STRUCTURE <VIM_TOTAL_STRUC> TO FIELD-SYMBOL(<WERKS>).
        ASSIGN COMPONENT 'LIFNR' OF STRUCTURE <VIM_TOTAL_STRUC> TO FIELD-SYMBOL(<LIFNR>).
        IF <WERKS> IS ASSIGNED AND <LIFNR> IS ASSIGNED.
*마지막 순번 확인
          SELECT SINGLE MAX( ZSEQ )
          FROM ZGTMMT1023
          WHERE WERKS = @<WERKS>
               AND LIFNR = @<LIFNR>
          INTO @DATA(LV_ZSEQ).
        ENDIF.

        ASSIGN COMPONENT 'ZSEQ' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
        IF SY-SUBRC = 0. <FS_FIELD> = LV_ZSEQ + 1. ENDIF.
      ENDIF.

      " 타임스탬프 정보 설정
      ASSIGN COMPONENT 'ERDAT' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
      IF SY-SUBRC = 0. <FS_FIELD> = SY-DATUM. ENDIF.

      ASSIGN COMPONENT 'ERDAT_LOCAL' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
      IF SY-SUBRC = 0. <FS_FIELD> = SY-DATLO. ENDIF.

      ASSIGN COMPONENT 'ERTIM' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
      IF SY-SUBRC = 0. <FS_FIELD> = SY-UZEIT. ENDIF.

      ASSIGN COMPONENT 'ERTIM_LOCAL' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
      IF SY-SUBRC = 0. <FS_FIELD> = SY-TIMLO. ENDIF.

      ASSIGN COMPONENT 'ERNAM' OF STRUCTURE <VIM_TOTAL_STRUC> TO <FS_FIELD>.
      IF SY-SUBRC = 0. <FS_FIELD> = SY-UNAME. ENDIF.

      MODIFY TOTAL.

      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
      IF SY-SUBRC = 0.
        EXTRACT = TOTAL.
        MODIFY EXTRACT INDEX SY-TABIX.
      ENDIF.

    ENDIF.
  ENDLOOP.

ENDFORM.

