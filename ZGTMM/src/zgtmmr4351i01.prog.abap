MODULE EXIT_COMMAND INPUT.
  CASE GV_OKCODE.
    WHEN 'BACK' OR 'EXIT' OR 'CANC'.
      PERFORM CLS_OBJT_RTN.
  ENDCASE.
ENDMODULE.
