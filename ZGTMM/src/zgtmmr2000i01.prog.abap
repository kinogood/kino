MODULE USER_COMMAND_0100 INPUT.

  CASE GV_OKCODE.
    WHEN 'SEND' OR 'RSEND'. "전송 / 재전송
      PERFORM F_SEND.

*    WHEN 'RSEND'. "재전송
*      PERFORM F_RE_SEND.
  ENDCASE.

ENDMODULE.
