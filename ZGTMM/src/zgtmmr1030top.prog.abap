*----------------------------------------------------------------------*
* GLOBAL VARIABLE
*----------------------------------------------------------------------*
* => GV + '_' XX.XXX
*----------------------------------------------------------------------*
DATA :
  GV_OKCODE        TYPE SY-UCOMM,
  GV_OKCODE_SAVE   TYPE SY-UCOMM,
  GV_OKCODE_SAVE2   TYPE SY-UCOMM,
  GV_ANSWER,
  GV_FIRST,
  GV_EDIT,
  GV_NEW,
  GV_ERR.

DATA :
  GV_BUDAT   TYPE DATUM,
  GV_BLDAT   TYPE DATUM,
  GV_SELPS   TYPE T021R-SELPS,
  GV_MODE(1),
  GV_300GB   TYPE CHAR1.   "1: 일반수금, 2: 할부금융

*----------------------------------------------------------------------*
* GLOBAL STRUCTURE
*----------------------------------------------------------------------*
* => GS + '_' XX.XXX
*----------------------------------------------------------------------*
DATA : BEGIN OF GS_LIST,

         WERKS            TYPE WERKS_D, "플랜트
         NAME1            TYPE NAME1,
         EKGRP            TYPE EKGRP,
         EKNAM            TYPE EKNAM,
         BNAME            TYPE XUBNAME,
         ANAME            TYPE ANAME,
         ERDAT             TYPE ERDAT,
         ERDAT_LOCAL TYPE ERDAT,
         ERTIM              TYPE ERZEIT,
         ERTIM_LOCAL  TYPE ERZEIT,
         ERNAM            TYPE ERNAM,

         STYLE       TYPE LVC_T_STYL,

       END OF GS_LIST.

DATA :  GS_RETURN LIKE BAPIRET2.

*----------------------------------------------------------------------*
* GLOBAL INTERNAL TABLE                                                *
*----------------------------------------------------------------------*
* => GT_ + XXX...XX                                                    *
*----------------------------------------------------------------------*
DATA : GT_LIST       LIKE TABLE OF GS_LIST.
DATA : GT_RETURN LIKE TABLE OF BAPIRET2.


