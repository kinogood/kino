*&---------------------------------------------------------------------*
*& Include MZNF2300TOP
*&---------------------------------------------------------------------*

PROGRAM  SAPMZNF2300 MESSAGE-ID ZNF1.

CONSTANTS: GC_TCODE1 LIKE SY-TCODE VALUE 'ZNF2M2301',   "생성(H)
           GC_TCODE2 LIKE SY-TCODE VALUE 'ZNF2M2302',   "변경(A)
           GC_TCODE3 LIKE SY-TCODE VALUE 'ZNF2M2303'.   "조회(V)

CONTROLS:  TC1            TYPE TABLEVIEW USING SCREEN 200.

DATA: GS_COLS       LIKE LINE OF TC1-COLS .

TABLES: ZNFT1000,
        ZNFT1010,
        ZNFT1011,
        ZNFT1020,
        ZNFT1030,
        ZNFT1040,
        ZNFT1090,
        ZNFT1091,
        ZZPA0001,
        ZPA0105.

DATA: BEGIN OF GT_1041 OCCURS 0.
        INCLUDE STRUCTURE ZNFT1041.
DATA:   CHECK,
        UPDKZ,
      END   OF GT_1041.

DATA: GT_1041D      LIKE ZNFT1041 OCCURS 0 WITH HEADER LINE.

DATA: GV_NAME1     LIKE LFA1-NAME1,       "FCM 명
      GV_NTEXT     LIKE ZNFT0005-NTEXT,   "사업부명
      GV_PTEXT     LIKE ZNFT0004-PTEXT,   "손익센터명
      GV_VTEXT     LIKE ZNFT0003-VTEXT,   "영업그룹명
      GV_PRIND(20),                        "가격구분
      GV_SUJUP(20).                        "비철수주가

DATA: GV_SHFNO LIKE ZNFT1040-SHFNO,
      GV_BUKRS LIKE ZNFT1040-BUKRS,
      GV_OFUTN LIKE ZNFT1040-OFUTN.

DATA: GV_SHFCNT TYPE I,
      GV_PERNR  LIKE ZNFT1090-PERNR,
*      GV_ENAME  LIKE PA0001-ENAME,
      GV_ENAME  LIKE ZZPA0001-ENAME. " [MM] HR 테이블 대체

DATA: GV_WAERS LIKE T001-WAERS,    "Currency
      GV_LAND1 LIKE T001-LAND1,    "Country
      GV_BUTXT LIKE T001-BUTXT,    "Company Name
      GV_KTOPL LIKE T001-KTOPL,    "Chart of Account
      GV_KOKRS LIKE TKA02-KOKRS.   "Controlling Area

DATA: GV_DEC        TYPE P DECIMALS 3.

DATA: GV_TRTYP      LIKE T180-TRTYP,
      GV_CURSOR(30),
      GV_CURLIN     TYPE I,
      GV_TITLE(50),
      GV_ANSWER,
      GV_ERROR.

*___Change Doc 관리용
DATA: YZNFT1040 LIKE ZNFT1040,
      XGT_1041  LIKE YZNFT1041 OCCURS 0 WITH HEADER LINE,
      YGT_1041  LIKE YZNFT1041 OCCURS 0 WITH HEADER LINE.

*___메일 전송용
DATA: GT_MESSAGE     TYPE BCSY_TEXT,
      GF_RECEIVER    TYPE REF TO IF_RECIPIENT_BCS,
      GC_EMAIL       TYPE REF TO CL_BCS,
      GC_EMAIL_BODY  TYPE REF TO CL_DOCUMENT_BCS,
      GC_EXCEPTION   TYPE REF TO CX_BCS,
      GV_ADDRESS     TYPE AD_SMTPADR,
      GT_FTEXT       TYPE LVC_TXTCOL OCCURS 0,
      GV_HDTITLE(40) TYPE C,
      GV_SUBJECT     TYPE SO_OBJ_DES,
      GV_SEND_RESULT.

*___결재자사번 - Search Help용
DATA: BEGIN OF GT_PERNR OCCURS 0,
        PERNR LIKE ZNFT1090-PERNR,
*        ENAME LIKE PA0001-ENAME,
        ENAME LIKE ZZPA0001-ENAME,  " [MM] HR 테이블 대체
      END   OF GT_PERNR.

DATA: BEGIN OF GT_EXCL OCCURS 0,
        FCODE LIKE SY-UCOMM,
      END   OF GT_EXCL.

DATA: OK_CODE LIKE SY-UCOMM,
      OK_SAVE LIKE SY-UCOMM.
