*&---------------------------------------------------------------------*
*& Include MZNF2100TOP
*&---------------------------------------------------------------------*

PROGRAM  SAPMZNF2111 MESSAGE-ID ZNF1.

CONSTANTS: GC_TCODE1 LIKE SY-TCODE VALUE 'ZNF2M2101',   "생성(H)
           GC_TCODE2 LIKE SY-TCODE VALUE 'ZNF2M2102',   "변경(A)
           GC_TCODE3 LIKE SY-TCODE VALUE 'ZNF2M2103'.   "조회(V)

CONTROLS:  TC1            TYPE TABLEVIEW USING SCREEN 200.

DATA: GS_COLS       LIKE LINE OF TC1-COLS .

TABLES: ZNFT1010,
        ZNFT1090,
        ZNFT1091,
        ZZPA0001,
        ZPA0105.

DATA: BEGIN OF GT_1011 OCCURS 0.
        INCLUDE STRUCTURE ZNFT1011.
DATA:   COTYP     LIKE ZNFT1000-COTYP,    "계약유형
        COTXT     LIKE ZNFT1000-COTXT,
        NFCTR     LIKE ZNFT1000-NFCTR,
        PRCTR     LIKE ZNFT1000-PRCTR,
        VKGRP     LIKE ZNFT1000-VKGRP,
        KUNNR     LIKE ZNFT1000-KUNNR,
        NCUST     LIKE ZNFT1000-NCUST,
        SALER     LIKE ZNFT1000-SALER,
        PRIND(20),
        SUJUP(20),
        WAERS     LIKE ZNFT1001-WAERS,
        CHECK,
        UPDKZ,
      END   OF GT_1011.

DATA: GS_1011       LIKE GT_1011.

DATA: GT_1011N LIKE ZNFT1011 OCCURS 0 WITH HEADER LINE,
      GT_1011D LIKE ZNFT1011 OCCURS 0 WITH HEADER LINE.

DATA: GV_REQNO     LIKE ZNFT1010-REQNO,
      GV_BUKRS     LIKE ZNFT1010-BUKRS,
      GV_RQTYP     LIKE ZNFT1010-RQTYP VALUE '1',
      GV_RQTXT(30),
      GV_RSTXT(20).

DATA: GV_PERNR LIKE ZNFT1090-PERNR,
*      GV_ENAME LIKE PA0001-ENAME,
      GV_ENAME LIKE ZZPA0001-ENAME.                         " PA0001 대체

DATA: GV_DEC        TYPE P DECIMALS 3.

DATA: GV_WAERS LIKE T001-WAERS,    "Currency
      GV_LAND1 LIKE T001-LAND1,    "Country
      GV_BUTXT LIKE T001-BUTXT,    "Company Name
      GV_KTOPL LIKE T001-KTOPL,    "Chart of Account
      GV_KOKRS LIKE TKA02-KOKRS.   "Controlling Area

DATA: GV_TRTYP      LIKE T180-TRTYP,
      GV_CURSOR(30),
      GV_CURLIN     TYPE I,
      GV_TITLE(50),
      GV_ANSWER,
      GV_ERROR.

*___Change Doc 관리용
DATA: YZNFT1010 LIKE ZNFT1010,
      XGT_1011  LIKE YZNFT1011 OCCURS 0 WITH HEADER LINE,
      YGT_1011  LIKE YZNFT1011 OCCURS 0 WITH HEADER LINE.

*___메일 전송용
DATA: GT_MESSAGE     TYPE BCSY_TEXT,
      GF_RECEIVER    TYPE REF TO IF_RECIPIENT_BCS,
      GC_EMAIL       TYPE REF TO CL_BCS,
      GC_EMAIL_BODY  TYPE REF TO CL_DOCUMENT_BCS,
      GC_EXCEPTION   TYPE REF TO CX_BCS,
      GV_ADDRESS     TYPE AD_SMTPADR,
      GT_FTEXT       TYPE LVC_TXTCOL OCCURS 0,
      GV_HDTITLE(40) TYPE C,
      GV_SUBJECT     TYPE SO_OBJ_DES,
      GV_SEND_RESULT.

DATA: BEGIN OF GT_EXCL OCCURS 0,
        FCODE LIKE SY-UCOMM,
      END   OF GT_EXCL.

DATA: OK_CODE LIKE SY-UCOMM,
      OK_SAVE LIKE SY-UCOMM.

*___F4 Help용 변수
DATA: SELECTFIELD  LIKE  HELP_INFO-FIELDNAME,
      IT_FIELDS    LIKE  HELP_VALUE OCCURS 1 WITH HEADER LINE,
      SELECT_VALUE LIKE  HELP_INFO-FLDVALUE,
      LD_TABIX     LIKE  SY-TABIX,
      GV_INDEX     LIKE  SY-INDEX.

DATA: SCR_FIELDS LIKE DYNPREAD OCCURS 0 WITH HEADER LINE,
      FELD_TABLE LIKE DYNPREAD OCCURS 0 WITH HEADER LINE.

*___계약번호
DATA: BEGIN OF GT_CONNO OCCURS 0,
        COTYP     LIKE ZNFT1000-COTYP,  "계약유형
        NFCTR     LIKE ZNFT1000-NFCTR,  "사업부
        PRCTR     LIKE ZNFT1000-PRCTR,  "손익센터
        VKGRP     LIKE ZNFT1000-VKGRP,  "영업그룹
        CONNO     LIKE ZNFT1000-CONNO,  "계약번호
        ERDAT     LIKE ZNFT1000-ERDAT,  "생성일
        COTXT     LIKE ZNFT1000-COTXT,  "계약명(PJT명)
        KUNNR     LIKE ZNFT1000-KUNNR,  "고객코드
        NCUST     LIKE ZNFT1000-NCUST,  "고객명
        SUJUD     LIKE ZNFT1000-SUJUD,  "수주일
        SALER     LIKE ZNFT1000-SALER,  "영업담당자
        NFKEY     LIKE ZNFT1001-NFKEY,  "비철구분
        PRIND(20),                        "가격구분
        SUJUP(20),                        "비철수주가격
        SUJUQ(20),                        "수주량
        EMENG     LIKE ZNFT1001-EMENG,  "수주량
        MEINS     LIKE ZNFT1001-MEINS,  "단위
      END   OF GT_CONNO.

*___결재자사번
DATA: BEGIN OF GT_PERNR OCCURS 0,
        PERNR LIKE ZNFT1090-PERNR,
*        ENAME LIKE PA0001-ENAM,
        ENAME LIKE ZZPA0001-ENAME,                          " PA0001 대체
      END   OF GT_PERNR.
