FUNCTION ZGTSD_RECEIVE_STOCK_LINK_INFO.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(I_VBELN) TYPE  VBELN_VA OPTIONAL
*"     VALUE(I_POSNR) TYPE  POSNR_VA OPTIONAL
*"     VALUE(I_MVGR3) TYPE  MVGR3 OPTIONAL
*"     VALUE(I_LIFSP) TYPE  LIFSP OPTIONAL
*"     VALUE(I_FIXMG) TYPE  FIXMG OPTIONAL
*"  EXPORTING
*"     VALUE(E_TYPE) TYPE  BAPI_MTYPE
*"     VALUE(E_MSG) TYPE  BAPI_MSG
*"----------------------------------------------------------------------
*&---------------------------------------------------------------------*
*&  모듈       : SD
*&  프로그램 ID : ZGTSD_RECEIVE_STOCK_LINK_INFO
*&  프로그램 명  : 재고 LINK 정보 수신
*&  개요       : 가온전선_생산으로 부터 재고 LINK 및 정조장 여부 정보를 수신한 후 SO/ITEM 에 업데이트
*&  생성일      : 2025.12.02
*&  생성자      : ZGODEV01
*&---------------------------------------------------------------------*
*& 외부호출 프로그램 개요   : N/A
*& 타 시스템 인터페이스 개요 : N/A
*----------------------------------------------------------------------*
*& 프로그램 수정이력
*&---------------------------------------------------------------------*
*& 수정일  :
*& 수정자  :
*& 수정개요 :
*&---------------------------------------------------------------------*
  DATA: LV_SALESDOCUMENT    TYPE BAPIVBELN-VBELN,
        LS_ORDER_HEADER_IN  TYPE BAPISDH1,
        LS_ORDER_HEADER_INX TYPE BAPISDH1X,
        LT_ORDER_ITEM_IN    TYPE TABLE OF BAPISDITM,
        LT_ORDER_ITEM_INX   TYPE TABLE OF BAPISDITMX,
        LT_SCHEDULE_LINES   TYPE TABLE OF BAPISCHDL,
        LT_SCHEDULE_LINESX  TYPE TABLE OF BAPISCHDLX,
        LT_CONDITIONS_IN    TYPE TABLE OF BAPICOND,
        LT_CONDITIONS_INX   TYPE TABLE OF BAPICONDX,
        LT_RETURN           TYPE TABLE OF BAPIRET2,
        LS_ORDER_ITEM_IN    TYPE BAPISDITM,
        LS_ORDER_ITEM_INX   TYPE BAPISDITMX,
        LS_SCHEDULE_LINES   TYPE BAPISCHDL,
        LS_SCHEDULE_LINESX  TYPE BAPISCHDLX,
        LS_CONDITIONS_IN    TYPE BAPICOND,
        LS_CONDITIONS_INX   TYPE BAPICONDX.
  DATA: LV_VBELN TYPE VBELN_VA,
        LV_POSNR TYPE POSNR_VA,
        LV_MVGR3 TYPE MVGR3,
        LV_LIFSP TYPE LIFSP,
        LV_FIXMG TYPE FIXMG.
  DATA: LV_MSG(220).
  DATA: LV_CHK(1),
        LV_CHK1(1),
        LV_CHK2(1),
        LV_CHK3(1).

*-01. 필수입력 체크
  IF I_VBELN IS INITIAL AND
     I_POSNR IS INITIAL.
    E_TYPE = GC_E.
    LV_MSG = |{ TEXT-001 }/{ TEXT-002 }|.
    MESSAGE S007 WITH LV_MSG INTO E_MSG.
    EXIT.
  ENDIF.

*-02. 자재그룹3/납품보류 입력 값
*  IF I_MVGR3 NE GC_X AND
*     I_MVGR3 NE SPACE.
*    E_TYPE = GC_E.
*    MESSAGE S000 WITH TEXT-M01 INTO E_MSG.
*    EXIT.
*  ENDIF.
*  IF I_LIFSP NE 'G2' AND
*     I_LIFSP NE 'G1' AND
  IF I_LIFSP NE 'G1' AND
     I_LIFSP NE SPACE.
    E_TYPE = GC_E.
    MESSAGE S000 WITH TEXT-M02 INTO E_MSG.
    EXIT.
  ENDIF.

  LV_VBELN = |{ I_VBELN ALPHA = IN }|.
  LV_POSNR = I_POSNR.
  LV_MVGR3 = I_MVGR3.
  LV_LIFSP = I_LIFSP.
  LV_FIXMG = I_FIXMG.

*-03. SO 존재 유무
  SELECT A~VBELN,A~POSNR,A~VKORG_ANA AS VKORG, A~MVGR3, A~FIXMG,
         B~ETENR,B~LIFSP
    FROM VBAP AS A INNER JOIN VBEP AS B
                   ON A~VBELN = B~VBELN AND
                      A~POSNR = B~POSNR
   WHERE A~VBELN     EQ @LV_VBELN
     AND A~POSNR     EQ @LV_POSNR
     AND A~VKORG_ANA EQ @GC_VKORG_6000
    INTO TABLE @DATA(LT_LIST).
  IF SY-SUBRC NE 0.
    CLEAR LV_MSG.
    E_TYPE = GC_E.
    MESSAGE S205 WITH LV_VBELN LV_POSNR INTO E_MSG.
    EXIT.
  ENDIF.
  SORT LT_LIST BY VBELN POSNR ETENR.
  DELETE ADJACENT DUPLICATES FROM LT_LIST COMPARING VBELN POSNR.

*-04. 변경사항 체크
  SORT LT_LIST BY VBELN POSNR ETENR.

  READ TABLE LT_LIST INTO DATA(LS_LIST) INDEX 1.

  CLEAR:LS_ORDER_ITEM_IN,LS_ORDER_ITEM_INX.
  LS_ORDER_ITEM_IN-ITM_NUMBER = LS_LIST-POSNR.

  LS_ORDER_ITEM_INX-ITM_NUMBER = LS_LIST-POSNR.
  LS_ORDER_ITEM_INX-UPDATEFLAG = GC_U.

  "자재그룹3
  IF LS_LIST-MVGR3 NE LV_MVGR3.
    LV_CHK1 = GC_X.

    LS_ORDER_ITEM_IN-PRC_GROUP3 = LV_MVGR3.

    LS_ORDER_ITEM_INX-PRC_GROUP3 = GC_X.

  ENDIF.

  "MTS 구분자(FIXMG)
  IF LS_LIST-FIXMG NE LV_FIXMG.
    LV_CHK2 = GC_X.

    LS_ORDER_ITEM_IN-FIXDAT_QTY = LV_FIXMG.

    LS_ORDER_ITEM_INX-FIXDAT_QTY = GC_X.

  ENDIF.

  "납품보류
  LOOP AT LT_LIST INTO LS_LIST.
    IF LS_LIST-LIFSP NE LV_LIFSP.
      LV_CHK3 = GC_X.

      CLEAR:LS_SCHEDULE_LINES,LS_SCHEDULE_LINESX.
      LS_SCHEDULE_LINES-ITM_NUMBER = LS_LIST-POSNR.
      LS_SCHEDULE_LINES-SCHED_LINE = LS_LIST-ETENR.
      LS_SCHEDULE_LINES-REQ_DLV_BL = LV_LIFSP.
      APPEND LS_SCHEDULE_LINES TO LT_SCHEDULE_LINES.

      LS_SCHEDULE_LINESX-ITM_NUMBER = LS_LIST-POSNR.
      LS_SCHEDULE_LINESX-SCHED_LINE = LS_LIST-ETENR.
      LS_SCHEDULE_LINESX-UPDATEFLAG = GC_U.
      LS_SCHEDULE_LINESX-REQ_DLV_BL = GC_X.
      APPEND LS_SCHEDULE_LINESX TO LT_SCHEDULE_LINESX.
    ENDIF.
  ENDLOOP.


*  "납품보류
*  IF LV_LIFSP EQ 'G1'.
*    "출하요청
*    SELECT SINGLE DLVRQ,VBELN,POSNR
*      FROM ZLET0401
*     WHERE VBELN EQ @LV_VBELN
*       AND POSNR EQ @LV_POSNR
*       AND LVORM EQ @SPACE
*      INTO @DATA(LS_ZLET0401).
*    IF SY-SUBRC NE 0.
*      "납품생성여부
*      SELECT SINGLE VBELN,POSNR
*        FROM LIPS
*       WHERE VGBEL EQ @LV_VBELN
*         AND VGPOS EQ @LV_POSNR
*        INTO @DATA(LS_LIPS).
*      IF SY-SUBRC NE 0.
*        LV_CHK = GC_X.
*      ENDIF.
*    ENDIF.
*
*    IF LV_CHK EQ GC_X.
*
*      LOOP AT LT_LIST INTO LS_LIST.
*        IF LS_LIST-LIFSP EQ SPACE.
*          LV_CHK2 = GC_X.
*
*          CLEAR:LS_SCHEDULE_LINES,LS_SCHEDULE_LINESX.
*          LS_SCHEDULE_LINES-ITM_NUMBER = LS_LIST-POSNR.
*          LS_SCHEDULE_LINES-SCHED_LINE = LS_LIST-ETENR.
*          LS_SCHEDULE_LINES-REQ_DLV_BL = LV_LIFSP.
*          APPEND LS_SCHEDULE_LINES TO LT_SCHEDULE_LINES.
*
*          LS_SCHEDULE_LINESX-ITM_NUMBER = LS_LIST-POSNR.
*          LS_SCHEDULE_LINESX-SCHED_LINE = LS_LIST-ETENR.
*          LS_SCHEDULE_LINESX-UPDATEFLAG = GC_U.
*          LS_SCHEDULE_LINESX-REQ_DLV_BL = GC_X.
*          APPEND LS_SCHEDULE_LINESX TO LT_SCHEDULE_LINESX.
*        ENDIF.
*
*      ENDLOOP.
*    ELSE.
*      CLEAR LV_MSG.
*      E_TYPE = GC_E.
*      MESSAGE S000 WITH TEXT-M66 INTO E_MSG.
*      EXIT.
*    ENDIF.
*
*  ELSE.
*    LOOP AT LT_LIST INTO LS_LIST.
*      IF LS_LIST-LIFSP NE LV_LIFSP.
*        LV_CHK2 = GC_X.
*
*        CLEAR:LS_SCHEDULE_LINES,LS_SCHEDULE_LINESX.
*        LS_SCHEDULE_LINES-ITM_NUMBER = LS_LIST-POSNR.
*        LS_SCHEDULE_LINES-SCHED_LINE = LS_LIST-ETENR.
*        LS_SCHEDULE_LINES-REQ_DLV_BL = LV_LIFSP.
*        APPEND LS_SCHEDULE_LINES TO LT_SCHEDULE_LINES.
*
*        LS_SCHEDULE_LINESX-ITM_NUMBER = LS_LIST-POSNR.
*        LS_SCHEDULE_LINESX-SCHED_LINE = LS_LIST-ETENR.
*        LS_SCHEDULE_LINESX-UPDATEFLAG = GC_U.
*        LS_SCHEDULE_LINESX-REQ_DLV_BL = GC_X.
*        APPEND LS_SCHEDULE_LINESX TO LT_SCHEDULE_LINESX.
*      ENDIF.
*
*    ENDLOOP.
*  ENDIF.

  IF LV_CHK1 IS INITIAL AND
     LV_CHK2 IS INITIAL AND
     LV_CHK3 IS INITIAL.
    CLEAR LV_MSG.
    E_TYPE = GC_S.
    MESSAGE S000 WITH TEXT-M03 INTO E_MSG.
    EXIT.
  ENDIF.

*-05. 영업문서 변경
*  IF LV_CHK1 IS INITIAL AND
*     LV_CHK2 IS NOT INITIAL.
*    CLEAR:LS_ORDER_ITEM_IN,LS_ORDER_ITEM_INX.
*    LS_ORDER_ITEM_IN-ITM_NUMBER = LS_LIST-POSNR.
*    APPEND LS_ORDER_ITEM_IN TO LT_ORDER_ITEM_IN.
*
*    LS_ORDER_ITEM_INX-ITM_NUMBER = LS_LIST-POSNR.
*    LS_ORDER_ITEM_INX-UPDATEFLAG = GC_U.
*    APPEND LS_ORDER_ITEM_INX TO LT_ORDER_ITEM_INX.
*  ENDIF.

  APPEND LS_ORDER_ITEM_IN  TO LT_ORDER_ITEM_IN.
  APPEND LS_ORDER_ITEM_INX TO LT_ORDER_ITEM_INX.

  LV_SALESDOCUMENT = I_VBELN.
  LS_ORDER_HEADER_INX = GC_U.

  CALL FUNCTION 'BAPI_SALESORDER_CHANGE'
    EXPORTING
      SALESDOCUMENT    = LV_SALESDOCUMENT
      ORDER_HEADER_IN  = LS_ORDER_HEADER_IN
      ORDER_HEADER_INX = LS_ORDER_HEADER_INX
    TABLES
      RETURN           = LT_RETURN
      ORDER_ITEM_IN    = LT_ORDER_ITEM_IN
      ORDER_ITEM_INX   = LT_ORDER_ITEM_INX
      SCHEDULE_LINES   = LT_SCHEDULE_LINES
      SCHEDULE_LINESX  = LT_SCHEDULE_LINESX
      CONDITIONS_IN    = LT_CONDITIONS_IN
      CONDITIONS_INX   = LT_CONDITIONS_INX.

  LOOP AT LT_RETURN INTO DATA(LS_RETURN) WHERE TYPE CA 'AE'.
    EXIT.
  ENDLOOP.
  IF SY-SUBRC EQ 0.
    __BAPI_TRANSACTION_ROLLBACK.

    E_TYPE = GC_E.

    LOOP AT LT_RETURN INTO LS_RETURN WHERE TYPE CA 'AE'.
      IF LV_MSG IS INITIAL.
        LV_MSG = LS_RETURN-MESSAGE.
      ELSE.
        LV_MSG = |{ LV_MSG }/{ LS_RETURN-MESSAGE }|.
      ENDIF.
    ENDLOOP.
    E_MSG = LV_MSG.
  ELSE.
    __BAPI_TRANSACTION_COMMIT.

    E_TYPE = GC_S.
    E_MSG  = TEXT-S01.
  ENDIF.

ENDFUNCTION.
