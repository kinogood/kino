"Name: \FU:MAP2E_BP3100\SE:END\EI
ENHANCEMENT 0 ZGTSD_EH_MAP2E_BP3100.
* 가온전선 추가 필드

* 보증기관
  MOVE BP3100-ZZGUR_AGY
    TO BAPI_STR_BUPA_FS_ADDITION-ZZGUR_AGY.

* 지역
  MOVE BP3100-ZZAREA
    TO BAPI_STR_BUPA_FS_ADDITION-ZZAREA.

* m2
  MOVE BP3100-ZZSQUARE
    TO BAPI_STR_BUPA_FS_ADDITION-ZZSQUARE.

* 근저당순위
  MOVE BP3100-ZZCOLSEC_PRI
    TO BAPI_STR_BUPA_FS_ADDITION-ZZCOLSEC_PRI.

* 근저당설정일
  MOVE BP3100-ZZCOLSEC_SET
    TO BAPI_STR_BUPA_FS_ADDITION-ZZCOLSEC_SET.

* 상세주소
  MOVE BP3100-ZZADDRESS
    TO BAPI_STR_BUPA_FS_ADDITION-ZZADDRESS.

* 총 판매계획
  IF NOT BP3100-ZZS_PLAN IS INITIAL.
    IF BP3100-CURR IS INITIAL.
      MESSAGE E537(B1) WITH
      'BP3100-CURR                                                  ' "#EC *
      ''
      'ZZS_PLAN                          '
      RAISING ERROR_CONVERTING_CURR_AMOUNT.
    ELSE.

      CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_EXTERN_9'
        EXPORTING
          CURRENCY        = BP3100-CURR
          AMOUNT_INTERNAL = BP3100-ZZS_PLAN
        IMPORTING
          AMOUNT_EXTERNAL = BAPI_STR_BUPA_FS_ADDITION-ZZS_PLAN.

    ENDIF.
  ELSE.
    CLEAR BAPI_STR_BUPA_FS_ADDITION-ZZS_PLAN.
  ENDIF.

* 수금계획-현금
  IF NOT BP3100-ZZC_PLAN_C IS INITIAL.
    IF BP3100-CURR IS INITIAL.
      MESSAGE E537(B1) WITH
      'BP3100-CURR                                                  ' "#EC *
      ''
      'ZZC_PLAN_C                          '
      RAISING ERROR_CONVERTING_CURR_AMOUNT.
    ELSE.

      CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_EXTERN_9'
        EXPORTING
          CURRENCY        = BP3100-CURR
          AMOUNT_INTERNAL = BP3100-ZZC_PLAN_C
        IMPORTING
          AMOUNT_EXTERNAL = BAPI_STR_BUPA_FS_ADDITION-ZZC_PLAN_C.

    ENDIF.
  ELSE.
    CLEAR BAPI_STR_BUPA_FS_ADDITION-ZZC_PLAN_C.
  ENDIF.

* 수금계획-어음
  IF NOT BP3100-ZZC_PLAN_N IS INITIAL.
    IF BP3100-CURR IS INITIAL.
      MESSAGE E537(B1) WITH
      'BP3100-CURR                                                  ' "#EC *
      ''
      'ZZC_PLAN_N                          '
      RAISING ERROR_CONVERTING_CURR_AMOUNT.
    ELSE.

      CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_EXTERN_9'
        EXPORTING
          CURRENCY        = BP3100-CURR
          AMOUNT_INTERNAL = BP3100-ZZC_PLAN_N
        IMPORTING
          AMOUNT_EXTERNAL = BAPI_STR_BUPA_FS_ADDITION-ZZC_PLAN_N.

    ENDIF.
  ELSE.
    CLEAR BAPI_STR_BUPA_FS_ADDITION-ZZC_PLAN_N.
  ENDIF.

* 근저당설정액
  IF NOT BP3100-ZZCOLSEC_AMT IS INITIAL.
    IF BP3100-CURR IS INITIAL.
      MESSAGE E537(B1) WITH
      'BP3100-CURR                                                  ' "#EC *
      ''
      'ZZCOLSEC_AMT                          '
      RAISING ERROR_CONVERTING_CURR_AMOUNT.
    ELSE.

      CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_EXTERN_9'
        EXPORTING
          CURRENCY        = BP3100-CURR
          AMOUNT_INTERNAL = BP3100-ZZCOLSEC_AMT
        IMPORTING
          AMOUNT_EXTERNAL = BAPI_STR_BUPA_FS_ADDITION-ZZCOLSEC_AMT.

    ENDIF.
  ELSE.
    CLEAR BAPI_STR_BUPA_FS_ADDITION-ZZCOLSEC_AMT.
  ENDIF.

* 선순위금액
  IF NOT BP3100-ZZCOLSEC_AMT_P IS INITIAL.
    IF BP3100-CURR IS INITIAL.
      MESSAGE E537(B1) WITH
      'BP3100-CURR                                                  ' "#EC *
      ''
      'ZZCOLSEC_AMT_P                          '
      RAISING ERROR_CONVERTING_CURR_AMOUNT.
    ELSE.

      CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_EXTERN_9'
        EXPORTING
          CURRENCY        = BP3100-CURR
          AMOUNT_INTERNAL = BP3100-ZZCOLSEC_AMT_P
        IMPORTING
          AMOUNT_EXTERNAL = BAPI_STR_BUPA_FS_ADDITION-ZZCOLSEC_AMT_P.

    ENDIF.
  ELSE.
    CLEAR BAPI_STR_BUPA_FS_ADDITION-ZZCOLSEC_AMT_P.
  ENDIF.

* 부동산시세
  IF NOT BP3100-ZZREALEST_AMT IS INITIAL.
    IF BP3100-CURR IS INITIAL.
      MESSAGE E537(B1) WITH
      'BP3100-CURR                                                  ' "#EC *
      ''
      'ZZREALEST_AMT                          '
      RAISING ERROR_CONVERTING_CURR_AMOUNT.
    ELSE.

      CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_EXTERN_9'
        EXPORTING
          CURRENCY        = BP3100-CURR
          AMOUNT_INTERNAL = BP3100-ZZREALEST_AMT
        IMPORTING
          AMOUNT_EXTERNAL = BAPI_STR_BUPA_FS_ADDITION-ZZREALEST_AMT.

    ENDIF.
  ELSE.
    CLEAR BAPI_STR_BUPA_FS_ADDITION-ZZREALEST_AMT.
  ENDIF.
ENDENHANCEMENT.
