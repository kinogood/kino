"Name: \PR:SAPLUKM_BUPA_01\FO:TC_FADE_OUT\SE:END\EI
ENHANCEMENT 0 ZGTSD_EH_UKM_BUPA_SCREEN.
* 가온전선 추가필드 정보범주별 활성/비활성 => 정보범주 '10' '50'에서만 활성화 함
  IF ( G_ADDINFO_SEGMENT(1) NE 'G'      ) OR  "가온전선 아닌 경우
     ( G_ADDINFO_SEGMENT(1) EQ 'G'  AND
       G_INFOCAT            NE '10' AND
       G_INFOCAT            NE '50'     ).   "가온전선 정보범주 '10' '50'이 아닌 경우

    SELECT FIELDNAME
      FROM DD03L
     WHERE TABNAME  EQ 'ZUKM_S_ADD_INFO_GO'
       AND AS4LOCAL EQ 'A'
      INTO TABLE @DATA(LT_FIELDS).
    IF LT_FIELDS[] IS NOT INITIAL.
      LOOP AT LT_FIELDS INTO DATA(LS_FIELD).
        CONCATENATE 'GT_ADDINFO-' LS_FIELD-FIELDNAME
               INTO L_TABFIELDNAME.
        PERFORM FIELDS_FADE_OUT USING L_TABFIELDNAME.
      ENDLOOP.

    ENDIF.

  ELSE.
    IF G_ADDINFO_SEGMENT(1) EQ 'G'  AND
       G_INFOCAT            EQ '10'.
      "총판매계획
      CLEAR:L_TABFIELDNAME.
      L_TABFIELDNAME = 'GT_ADDINFO-ZZS_PLAN'.
      PERFORM FIELDS_FADE_OUT USING L_TABFIELDNAME.
      "수금계획-현금
      CLEAR:L_TABFIELDNAME.
      L_TABFIELDNAME = 'GT_ADDINFO-ZZC_PLAN_C'.
      PERFORM FIELDS_FADE_OUT USING L_TABFIELDNAME.
      "수금계획-어음
      CLEAR:L_TABFIELDNAME.
      L_TABFIELDNAME = 'GT_ADDINFO-ZZC_PLAN_N'.
      PERFORM FIELDS_FADE_OUT USING L_TABFIELDNAME.
    ENDIF.

  ENDIF.

ENDENHANCEMENT.
