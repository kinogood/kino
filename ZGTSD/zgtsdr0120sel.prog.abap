*-------------------------------------------------------------------*
*   SELECTION SCREEN                                                *
*-------------------------------------------------------------------*
SELECTION-SCREEN SKIP 1.
SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-001.

  SELECTION-SCREEN SKIP 1.

  SELECT-OPTIONS : SO_KUNNR FOR VBAK-KUNNR OBLIGATORY.

  PARAMETERS : PA_VKORG TYPE VKORG OBLIGATORY MEMORY ID VKO,
               PA_VTWEG LIKE VBAK-VTWEG DEFAULT '10'   OBLIGATORY,
               PA_SPART LIKE VBAK-SPART OBLIGATORY.


  SELECT-OPTIONS : SO_VKBUR FOR LIPS-VKBUR NO-EXTENSION NO INTERVALS ,
                   SO_VKGRP FOR LIPS-VKGRP NO-EXTENSION NO INTERVALS.

  SELECT-OPTIONS : SO_WADAT FOR LIKP-WADAT_IST OBLIGATORY,
                   SO_FKTYP FOR VKDFS-FKTYP DEFAULT 'L',
                   SO_AUART FOR VBAK-AUART.

  PARAMETERS : PA_WBSTK LIKE VBUK-WBSTK DEFAULT 'C' OBLIGATORY.

  PARAMETERS : PA_FKSTA AS LISTBOX
                    VISIBLE LENGTH 20 OBLIGATORY DEFAULT 'T',
               PA_FKDAT LIKE VBRK-FKDAT OBLIGATORY.

  SELECTION-SCREEN SKIP 1.

  PARAMETERS: PA_CHK AS CHECKBOX DEFAULT ' '.
  PARAMETERS: PA_CHK2 AS CHECKBOX DEFAULT ' '.

  SELECTION-SCREEN SKIP 1.

  PARAMETERS: PA_IMODE LIKE HRVCOST-MODE DEFAULT 'N'.

  SELECTION-SCREEN SKIP 1.

  PARAMETERS: P_VARI    LIKE DISVARIANT-VARIANT.

SELECTION-SCREEN END OF BLOCK B1.
PARAMETERS: P_LOCK TYPE CHAR1 NO-DISPLAY,
            P_LOCAL LIKE VBKD-KDKG4 NO-DISPLAY DEFAULT '4D'.
