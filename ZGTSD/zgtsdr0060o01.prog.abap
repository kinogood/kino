*& Screen 0100 Status 정보 구성
*&---------------------------------------------------------------------*
MODULE status_0100 OUTPUT.

  DATA lt_fcode TYPE TABLE OF syucomm.

  CLEAR lt_fcode.

  CASE abap_true.
    WHEN p_crte.            " 생성

    WHEN p_search.          " 조회
      lt_fcode = VALUE #( ( 'CRTE' )
                        ).

  ENDCASE.

  SET PF-STATUS '0100' EXCLUDING lt_fcode.
  SET TITLEBAR  '0100'.

ENDMODULE.
