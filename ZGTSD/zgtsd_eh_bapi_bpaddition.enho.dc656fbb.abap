      'BP3100-CURR                                                  ' "#EC *
      BAPI_STR_BUPA_FS_ADDITION-ZZS_PLAN
      'ZZS_PLAN                        '
      RAISING ERROR_CONVERTING_CURR_AMOUNT.
    ELSE.
      CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_INTERN_9'
        EXPORTING
          CURRENCY             = BP3100-CURR
          AMOUNT_EXTERNAL      = BAPI_STR_BUPA_FS_ADDITION-ZZS_PLAN
          MAX_NUMBER_OF_DIGITS = 15
        IMPORTING
          AMOUNT_INTERNAL      = BP3100-ZZS_PLAN
          RETURN               = L_STR_RETURN.

      IF NOT L_STR_RETURN IS INITIAL.
        MESSAGE E536(B1) WITH
        BAPI_STR_BUPA_FS_ADDITION-ZZS_PLAN
        BP3100-CURR
        'ZZS_PLAN                        '
        RAISING ERROR_CONVERTING_CURR_AMOUNT.
