CLASS ZGTSD_CL_COMMON2 IMPLEMENTATION.


METHOD BP_DISPLAY.
  DATA: LV_BP_GUID TYPE BU_PARTNER_GUID.
  DATA: LV_PARTNER TYPE BU_PARTNER.
  DATA: LT_BP_ASSIGNED_ROLES TYPE STANDARD TABLE OF BAPIBUS1006_ROLES.
  DATA: LV_PARTNER_ROLE TYPE BU_PARTNERROLE.
  DATA: LT_TB003 TYPE STANDARD TABLE OF TB003.

  LV_PARTNER = IV_PARTNER.

  SELECT SINGLE PARTNER_GUID
    FROM BUT000
   WHERE PARTNER EQ @LV_PARTNER
    INTO @LV_BP_GUID.
  IF SY-SUBRC NE 0.
    MESSAGE I000(ZGTSD01) WITH 'BP가 존재하지 않습니다.'.
    EXIT.
  ENDIF.

  CALL FUNCTION 'BUPA_ROLES_READ'
    EXPORTING
      IV_PARTNER_GUID = LV_BP_GUID
      IV_PARTNER      = LV_PARTNER
    TABLES
      ET_PARTNERROLES = LT_BP_ASSIGNED_ROLES.

  SORT LT_BP_ASSIGNED_ROLES BY PARTNERROLE.

  IF NOT LT_BP_ASSIGNED_ROLES IS INITIAL.
    SELECT *
           FROM TB003 INTO TABLE LT_TB003
           FOR ALL ENTRIES IN LT_BP_ASSIGNED_ROLES
           WHERE ROLE EQ LT_BP_ASSIGNED_ROLES-PARTNERROLE
             AND BPVIEW EQ IV_ROLE  "'FLCU01'
             AND XSUPPRESS EQ SPACE
             AND STND_ROLECAT NE SPACE.
    IF SY-SUBRC <> 0.
      SELECT *
             FROM TB003 INTO TABLE LT_TB003
             FOR ALL ENTRIES IN LT_BP_ASSIGNED_ROLES
             WHERE ROLE EQ LT_BP_ASSIGNED_ROLES-PARTNERROLE
               AND BPVIEW EQ IV_ROLE "'FLCU01'
               AND XSUPPRESS EQ SPACE.
    ENDIF.
    SORT LT_TB003 BY ROLE.
  ENDIF.

  LV_PARTNER_ROLE = IV_ROLE. "'FLCU01'.
  READ TABLE LT_TB003 TRANSPORTING NO FIELDS
       WITH KEY ROLE = LV_PARTNER_ROLE BINARY SEARCH.
  IF SY-SUBRC <> 0.
    READ TABLE LT_TB003 ASSIGNING FIELD-SYMBOL(<LS_TB003>) INDEX 1.
    IF SY-SUBRC = 0.
      LV_PARTNER_ROLE = <LS_TB003>-ROLE.
    ELSE.
      LV_PARTNER_ROLE = '000000'.
    ENDIF.
  ENDIF.

* Set request
  DATA(LO_REQUEST) = NEW CL_BUPA_NAVIGATION_REQUEST( ).
  LO_REQUEST->SET_MAINTENANCE_ID( CL_BUPA_NAVIGATION_REQUEST=>GC_MAINTENANCE_ID_PARTNER ).

  LO_REQUEST->SET_BUPA_PARTNER_ROLE( VALUE #( ROLE = LV_PARTNER_ROLE ) ).
  IF IV_CHANGE IS NOT INITIAL.
    LO_REQUEST->SET_BUPA_ACTIVITY( CL_BUPA_NAVIGATION_REQUEST=>GC_ACTIVITY_CHANGE ).
  ELSE.
    LO_REQUEST->SET_BUPA_ACTIVITY( CL_BUPA_NAVIGATION_REQUEST=>GC_ACTIVITY_DISPLAY ).
  ENDIF.
  LO_REQUEST->SET_PARTNER_GUID( LV_BP_GUID ) .
  LO_REQUEST->EXPORT( ).

* Set options
  DATA(LO_OPTIONS) = NEW CL_BUPA_DIALOG_JOEL_OPTIONS( ).
  LO_OPTIONS->SET_LOCATOR_VISIBLE( ABAP_FALSE ).
  LO_OPTIONS->SET_NAVIGATION_DISABLED( ABAP_FALSE ).
  LO_OPTIONS->SET_ACTIVITY_SWITCHING_OFF( ABAP_TRUE ).
  LO_OPTIONS->SET_SAVE_TO_LEAVE( ABAP_TRUE ).
  LO_OPTIONS->EXPORT( ).

  CALL TRANSACTION 'BP' WITH AUTHORITY-CHECK AND SKIP FIRST SCREEN.
ENDMETHOD.


METHOD CONV_EXIT_MATN1_INPUT.
  DATA: LV_OT TYPE MATNR,
        LV_IN TYPE MATNR.

  CHECK CV_MATNR IS NOT INITIAL.
  LV_IN = CV_MATNR.

  CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
    EXPORTING
      INPUT  = LV_IN
    IMPORTING
      OUTPUT = LV_OT.
  IF SY-SUBRC EQ 0.
    CV_MATNR = LV_OT.
  ELSE.
    CV_MATNR = LV_IN.
  ENDIF.

ENDMETHOD.


METHOD CONV_EXIT_MATN1_OUTPUT.
  DATA: LV_OT TYPE MATNR,
        LV_IN TYPE MATNR.

  CHECK CV_MATNR IS NOT INITIAL.
  LV_IN = CV_MATNR.

  CALL FUNCTION 'CONVERSION_EXIT_MATN1_OUTPUT'
    EXPORTING
      INPUT  = LV_IN
    IMPORTING
      OUTPUT = LV_OT.

  IF SY-SUBRC EQ 0.
    CV_MATNR = LV_OT.
  ELSE.
    CV_MATNR = LV_IN.
  ENDIF.
ENDMETHOD.


METHOD CONV_TO_LOCAL_CURRENCY.
  DATA:LV_AMT TYPE WRBTR.

  CALL FUNCTION 'CONVERT_TO_LOCAL_CURRENCY'
    EXPORTING
      DATE             = IV_DATE
      FOREIGN_AMOUNT   = IV_FR_AMT
      FOREIGN_CURRENCY = IV_FR_CUR
      LOCAL_CURRENCY   = IV_TO_CUR
    IMPORTING
      LOCAL_AMOUNT     = LV_AMT
    EXCEPTIONS
      NO_RATE_FOUND    = 1
      OVERFLOW         = 2
      NO_FACTORS_FOUND = 3
      NO_SPREAD_FOUND  = 4
      DERIVED_2_TIMES  = 5
      OTHERS           = 6.
  IF SY-SUBRC EQ 0.
    RV_AMT = LV_AMT.
  ENDIF.
ENDMETHOD.


