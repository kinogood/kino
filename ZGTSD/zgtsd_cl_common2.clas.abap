    FROM T001W
   WHERE WERKS EQ @IV_WERKS
    INTO @DATA(LV_TEXT).
  IF SY-SUBRC EQ 0.
    RV_TEXT = LV_TEXT.
  ENDIF.
ENDMETHOD.


METHOD GET_ZTERM_TEXT.
  SELECT SINGLE TEXT1
    FROM T052U
   WHERE ZTERM EQ @IV_ZTERM
     AND SPRAS EQ @IV_SPRAS
    INTO @DATA(LV_TEXT).
  IF SY-SUBRC EQ 0.
    RV_TEXT = LV_TEXT.
  ENDIF.
ENDMETHOD.


METHOD MD_CONVERT_MATERIAL_UNIT.
  DATA:LV_QTY TYPE MENGE_D.

  IF IV_MATNR IS NOT INITIAL AND
     IV_IN_ME IS NOT INITIAL AND
     IV_OT_ME IS NOT INITIAL AND
     IV_MENGE IS NOT INITIAL.

    CALL FUNCTION 'MD_CONVERT_MATERIAL_UNIT'
      EXPORTING
        I_MATNR              = IV_MATNR
        I_IN_ME              = IV_IN_ME
        I_OUT_ME             = IV_OT_ME
        I_MENGE              = IV_MENGE
      IMPORTING
        E_MENGE              = LV_QTY
      EXCEPTIONS
        ERROR_IN_APPLICATION = 1
        ERROR                = 2
        OTHERS               = 3.
    IF SY-SUBRC EQ 0.
      RV_MENGE = LV_QTY.
    ELSE.
      RV_MENGE = IV_MENGE.
    ENDIF.


  ELSE.
    RV_MENGE = IV_MENGE.
  ENDIF.

ENDMETHOD.
ENDCLASS.
