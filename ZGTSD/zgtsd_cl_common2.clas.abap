ENDMETHOD.


METHOD GET_CURR_EXTERNAL.
  DATA: LV_WAERS  TYPE WAERS,
        LV_AMT_IN TYPE BAPICURX-BAPICURX,
        LV_AMT_OT TYPE BAPICURX-BAPICURX.

  LV_WAERS  = IV_WAERS.
  LV_AMT_IN = IV_AMT.

  IF LV_WAERS IS NOT INITIAL AND
     LV_AMT_IN NE 0.

    CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_EXTERN_9'
      EXPORTING
        CURRENCY        = LV_WAERS
        AMOUNT_INTERNAL = LV_AMT_IN
      IMPORTING
        AMOUNT_EXTERNAL = LV_AMT_OT.

    RV_AMT = LV_AMT_OT.

  ELSE.
    RV_AMT = LV_AMT_IN.
  ENDIF.

ENDMETHOD.


METHOD GET_CURR_INTERNAL.
  DATA: LV_WAERS  TYPE WAERS,
        LV_AMT_IN TYPE BAPICURX-BAPICURX,
        LV_AMT_OT TYPE BAPICURX-BAPICURX,
        LS_RETURN TYPE BAPIRETURN.

  LV_WAERS  = IV_WAERS.
  LV_AMT_IN = IV_AMT.

  IF LV_WAERS IS NOT INITIAL AND
     LV_AMT_IN NE 0.

    CALL FUNCTION 'BAPI_CURRENCY_CONV_TO_INTERN_9'
      EXPORTING
        CURRENCY             = LV_WAERS
        AMOUNT_EXTERNAL      = LV_AMT_IN
        MAX_NUMBER_OF_DIGITS = 17
      IMPORTING
        AMOUNT_INTERNAL      = LV_AMT_OT
        RETURN               = LS_RETURN.

    RV_AMT = LV_AMT_OT.

  ELSE.
    RV_AMT = LV_AMT_IN.
  ENDIF.
ENDMETHOD.


METHOD GET_KUNNR_TEXT.
