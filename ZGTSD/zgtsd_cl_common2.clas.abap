METHOD GET_TIMESTAMP_MULTI.
  DATA: LS_STRUCT TYPE ZGTSDS0000.

  FIELD-SYMBOLS: <FS_VAL> TYPE ANY.

  GET TIME.
  LS_STRUCT-ERNAM    = SY-UNAME.
  LS_STRUCT-ERDAT    = SY-DATLO.
  LS_STRUCT-ERZEIT   = SY-TIMLO.
  LS_STRUCT-ERDATLO  = SY-DATLO.
  LS_STRUCT-ERTIMLO  = SY-TIMLO.
  LS_STRUCT-ERTCODE  = SY-TCODE.
  LS_STRUCT-EREMPNO  = SY-UNAME.

  LOOP AT IT_VALUE ASSIGNING FIELD-SYMBOL(<FS_LINE>).
    ASSIGN COMPONENT 'ERDAT' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
    CHECK SY-SUBRC EQ 0.
    IF <FS_VAL> IS NOT INITIAL.
      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AEDAT' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERDAT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AEZEIT' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERZEIT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AEZET' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERZEIT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AENAM' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERNAM.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AEDATLO' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERDAT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AETIMLO' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERZEIT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AEEMPNO' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERNAM.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AETCODE' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERTCODE.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'AEEMPNO' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERNAM.
      ENDIF.


    ELSE.
      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'ERDAT' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERDAT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'ERZEIT' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERZEIT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'ERZET' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERZEIT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'ERNAM' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERNAM.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'ERDATLO' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERDAT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'ERTIMLO' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERZEIT.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'EREMPNO' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERNAM.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'ERTCODE' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERTCODE.
      ENDIF.

      UNASSIGN <FS_VAL>.
      ASSIGN COMPONENT 'EREMPNO' OF STRUCTURE <FS_LINE> TO <FS_VAL>.
      IF SY-SUBRC EQ 0.
        <FS_VAL> = LS_STRUCT-ERNAM.
      ENDIF.

    ENDIF.
  ENDLOOP.
ENDMETHOD.


METHOD GET_TIMESTAMP_SINGLE.
  FIELD-SYMBOLS: <FS_VAL> TYPE ANY.

  ASSIGN COMPONENT 'ERDAT' OF STRUCTURE IS_VALUE TO <FS_VAL>.
  CHECK SY-SUBRC EQ 0.

  IF <FS_VAL> IS NOT INITIAL.
    UNASSIGN <FS_VAL>.
    ASSIGN COMPONENT 'AEDAT' OF STRUCTURE IS_VALUE TO <FS_VAL>.
    IF SY-SUBRC EQ 0.
      <FS_VAL> = SY-DATLO.
