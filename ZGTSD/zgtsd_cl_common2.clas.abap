                   ON A~ADRNR = B~ADDRNUMBER
   WHERE A~KUNNR     EQ @IV_KUNNR
     AND B~DATE_FROM LE @SY-DATLO
     AND B~DATE_TO   GE @SY-DATLO
    INTO @DATA(LV_TEXT).
  IF SY-SUBRC EQ 0.
    RV_TEXT = LV_TEXT.
  ENDIF.
ENDMETHOD.


METHOD GET_LAST_DAY_MONTH.
  DATA: LV_DATE TYPE SY-DATUM.
  IF IV_DATE IS NOT INITIAL.
    CALL FUNCTION 'RP_LAST_DAY_OF_MONTHS'
      EXPORTING
        DAY_IN            = IV_DATE
      IMPORTING
        LAST_DAY_OF_MONTH = LV_DATE
      EXCEPTIONS
        DAY_IN_NO_DATE    = 1
        OTHERS            = 2.
    IF SY-SUBRC EQ 0.
      RV_DATE = LV_DATE.
    ELSE.
      RV_DATE = IV_DATE.
    ENDIF.

  ELSE.
    RV_DATE = IV_DATE.
  ENDIF.
ENDMETHOD.


