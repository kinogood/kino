FUNCTION ZGTSD_IF_I_SO_REJECT_STATUS.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(IS_D365_LOGIN) TYPE  ZSDS_LOG_0000 OPTIONAL
*"     VALUE(I_VBELN) TYPE  VBELN OPTIONAL
*"     VALUE(I_ZPJNO) TYPE  ZPJNO OPTIONAL
*"     VALUE(I_VKBUR) TYPE  VKBUR OPTIONAL
*"     VALUE(I_KUNNR) TYPE  KUNNR OPTIONAL
*"  EXPORTING
*"     VALUE(ES_RETURN) TYPE  ZSDS_LOG_0001
*"  TABLES
*"      ET_DATA STRUCTURE  ZGTSDSIF0011 OPTIONAL
*"----------------------------------------------------------------------

  INCLUDE ZSDC0000.

  DATA :   LV_MSG   TYPE CHAR200,
           LV_ZPJNO TYPE ZPJNO.

  RANGES : LR_VKBUR FOR VBAK-VKBUR,
           LR_ZPJNO FOR ZGTSDT1011-ZPJNO,
           LR_KUNNR FOR VBAK-KUNNR,
           LR_ERDAT FOR VBAK-ERDAT,
           LR_VBELN FOR VBAK-VBELN.

  CLEAR : ES_RETURN, ET_DATA, ET_DATA[], LV_ZPJNO, LV_MSG.
*-----------------------------------------------------------------------
*-- Import 값 정합성 체크
*-----------------------------------------------------------------------

  IF IS_D365_LOGIN-ENAME IS INITIAL.
    MESSAGE S007(ZGTSD01) WITH TEXT-E12 INTO LV_MSG.
    ES_RETURN = VALUE #( MTYPE = ZGTSD_E MESSAGE = LV_MSG ).
    PERFORM SAVE_LOG(ZCMR0004) TABLES GT_ILOG USING GS_HLOG ES_RETURN.
    EXIT.
  ENDIF.

  IF I_ZPJNO IS INITIAL.
    MESSAGE S007(ZGTSD01) WITH TEXT-E02 INTO LV_MSG.
    ES_RETURN = VALUE #( MTYPE = ZGTSD_E MESSAGE = LV_MSG ).
    PERFORM SAVE_LOG(ZCMR0004) TABLES GT_ILOG USING GS_HLOG ES_RETURN.
    EXIT.
  ELSE.
    IF I_ZPJNO(2) NE 'PD'.
      LV_ZPJNO = I_ZPJNO(8) && `*`.
      __RNG LR_ZPJNO 'I' 'CP' LV_ZPJNO ''.
    ELSE.
      LV_ZPJNO = I_ZPJNO.
      __RNG LR_ZPJNO 'I' 'EQ' LV_ZPJNO ''.
    ENDIF.
  ENDIF.

  IF I_VKBUR IS NOT INITIAL.
    __RNG LR_VKBUR 'I' 'EQ' I_VKBUR ''.
  ENDIF.

  IF I_KUNNR IS NOT INITIAL.
    __RNG LR_KUNNR 'I' 'EQ' I_KUNNR ''.
  ENDIF.

  IF I_VBELN IS NOT INITIAL.
    __RNG LR_VBELN 'I' 'EQ' I_VBELN ''.
  ENDIF.

  SELECT A~*, B~BSTNK AS BSTKD
    INTO CORRESPONDING FIELDS OF TABLE @ET_DATA
    FROM ZGTSDT1011 AS A
    LEFT OUTER JOIN VBAK AS B
      ON B~VBELN = A~VBELN
    WHERE A~VKORG = @IS_D365_LOGIN-VKORG
      AND A~VKBUR  IN @LR_VKBUR
      AND A~ZPJNO  IN @LR_ZPJNO
      AND A~KUNNR  IN @LR_KUNNR
      AND A~VBELN  IN @LR_VBELN
      AND A~ERDAT  IN @LR_ERDAT.

  IF ET_DATA[] IS NOT INITIAL.
    ES_RETURN = VALUE #( MTYPE = ZGTSD_S MESSAGE = TEXT-M09 ).
  ELSE.
    ES_RETURN = VALUE #( MTYPE = ZGTSD_E MESSAGE = TEXT-M10 ).
  ENDIF.

  PERFORM SAVE_LOG(ZCMR0004) TABLES GT_ILOG USING GS_HLOG ES_RETURN.

ENDFUNCTION.
