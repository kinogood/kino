FUNCTION ZGTSD_DO_BATCH_SPLIT.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  EXPORTING
*"     VALUE(E_TYPE) TYPE  BAPI_MTYPE
*"     VALUE(E_MSG) TYPE  BAPI_MSG
*"  TABLES
*"      IT_ITEM STRUCTURE  ZGTSDS0023
*"      IT_BATCH STRUCTURE  ZGTSDS0024
*"----------------------------------------------------------------------
  DATA: LV_SUM_LIPS TYPE LIPS-LFIMG,
        LV_SUM_INPT TYPE LIPS-LFIMG.
  DATA: LV_H,LV_V,LV_D.
  DATA: LV_MSG(200).

  CLEAR:GS_LIKP,GT_LIPS[].

*-01. GET DO
  DATA(LS_TEMP) = VALUE #( IT_ITEM[ 1 ] OPTIONAL ).
  PERFORM GET_DO_INFO USING LS_TEMP-VBELN.

  IF GS_LIKP IS INITIAL.
    E_TYPE = GC_E.
    E_MSG  = TEXT-M07.
    EXIT.
  ENDIF.

*-02. INIT PARAMETERS
  PERFORM INIT_PARAMETRS.


  LOOP AT IT_ITEM INTO DATA(LS_ITEM).
    CLEAR:LV_SUM_LIPS,LV_SUM_INPT.
    CLEAR:LV_H,LV_V,LV_D.

    "DO ITEM 수량 SUM( BATCH SPLIT LINE 포함)
    LOOP AT GT_LIPS INTO DATA(LS_LIPS) WHERE ( VBELN = LS_ITEM-VBELN AND POSNR = LS_ITEM-POSNR )
                                          OR ( VBELN = LS_ITEM-VBELN AND UECHA = LS_ITEM-POSNR ).
      LV_SUM_LIPS = LV_SUM_LIPS + LS_LIPS-LFIMG.
    ENDLOOP.

    CLEAR LS_LIPS.
    LS_LIPS = VALUE #( GT_LIPS[ VBELN = LS_ITEM-VBELN
                                POSNR = LS_ITEM-POSNR ] OPTIONAL ).

    IF LINE_EXISTS( IT_BATCH[ UECHA = LS_ITEM-POSNR ] ).
      CLEAR:GS_ITEM_CONTROL,GS_ITEM_DATA_SPL.

      GS_ITEM_CONTROL-DELIV_NUMB = LS_LIPS-VBELN.
      GS_ITEM_CONTROL-DELIV_ITEM = LS_LIPS-POSNR.
      GS_ITEM_CONTROL-CHG_DELQTY = GC_X.
      APPEND GS_ITEM_CONTROL TO GT_ITEM_CONTROL.

      IF LS_ITEM-LGORT NE LS_LIPS-LGORT.
        GS_ITEM_DATA_SPL-DELIV_NUMB = LS_LIPS-VBELN.
        GS_ITEM_DATA_SPL-DELIV_ITEM = LS_LIPS-POSNR.
        GS_ITEM_DATA_SPL-STGE_LOC   = LS_ITEM-LGORT.
        APPEND GS_ITEM_DATA_SPL TO GT_ITEM_DATA_SPL.
      ENDIF.
    ENDIF.

*---BATCH SPLIT 삭제
    IF LINE_EXISTS( IT_BATCH[ VBELN = LS_ITEM-VBELN
                              UECHA = LS_ITEM-POSNR
                              UPDKZ = GC_D ] ).
      LV_D = GC_X.

      LOOP AT IT_BATCH INTO DATA(LS_BATCH) WHERE VBELN = LS_ITEM-VBELN
                                             AND UECHA = LS_ITEM-POSNR
                                             AND UPDKZ = GC_D.
        CLEAR:GS_ITEM_DATA,GS_ITEM_CONTROL.

        GS_ITEM_DATA-DELIV_NUMB      = LS_LIPS-VBELN.
        GS_ITEM_DATA-DELIV_ITEM      = LS_BATCH-POSNR.
        GS_ITEM_DATA-MATERIAL_LONG   = LS_BATCH-MATNR.
        GS_ITEM_DATA-BATCH           = LS_BATCH-CHARG.
        GS_ITEM_DATA-HIERARITEM      = LS_BATCH-UECHA.
        GS_ITEM_DATA-USEHIERITM      = '1'.
        GS_ITEM_DATA-DLV_QTY         = LS_BATCH-LFIMG.
        GS_ITEM_DATA-SALES_UNIT      = LS_ITEM-VRKME.
        GS_ITEM_DATA-FACT_UNIT_NOM   = LS_LIPS-UMVKZ.
        GS_ITEM_DATA-FACT_UNIT_DENOM = LS_LIPS-UMVKN.
        GS_ITEM_DATA-CONV_FACT       = LS_LIPS-UMREF.
        APPEND GS_ITEM_DATA TO GT_ITEM_DATA.

        GS_ITEM_CONTROL-DELIV_NUMB = LS_LIPS-VBELN.
        GS_ITEM_CONTROL-DELIV_ITEM = LS_BATCH-POSNR.
        GS_ITEM_CONTROL-DEL_ITEM   = GC_X.
        APPEND GS_ITEM_CONTROL TO GT_ITEM_CONTROL.

      ENDLOOP.

    ENDIF.

*---BATCH SPLIT 신규 ITEM
    IF LINE_EXISTS( IT_BATCH[ VBELN = LS_ITEM-VBELN
                              UECHA = LS_ITEM-POSNR
                              UPDKZ = GC_I          ] ).
      LV_H = GC_X.

      LOOP AT IT_BATCH INTO LS_BATCH WHERE VBELN = LS_ITEM-VBELN
                                       AND UECHA = LS_ITEM-POSNR
                                       AND UPDKZ = GC_I.

        CLEAR:GS_ITEM_DATA,GS_ITEM_CONTROL.

        LV_SUM_INPT = LV_SUM_INPT + LS_BATCH-LFIMG.

        GS_ITEM_DATA-DELIV_NUMB      = LS_LIPS-VBELN.
        GS_ITEM_DATA-DELIV_ITEM      = LS_BATCH-POSNR.
        GS_ITEM_DATA-MATERIAL_LONG   = LS_BATCH-MATNR.
        GS_ITEM_DATA-BATCH           = LS_BATCH-CHARG.
        GS_ITEM_DATA-HIERARITEM      = LS_BATCH-UECHA.
        GS_ITEM_DATA-USEHIERITM      = '1'.
        GS_ITEM_DATA-DLV_QTY         = LS_BATCH-LFIMG.
        GS_ITEM_DATA-SALES_UNIT      = LS_ITEM-VRKME.
        GS_ITEM_DATA-FACT_UNIT_NOM   = LS_LIPS-UMVKZ.
        GS_ITEM_DATA-FACT_UNIT_DENOM = LS_LIPS-UMVKN.
        GS_ITEM_DATA-CONV_FACT       = LS_LIPS-UMREF.
        APPEND GS_ITEM_DATA TO GT_ITEM_DATA.

        GS_ITEM_CONTROL-DELIV_NUMB = LS_LIPS-VBELN.
        GS_ITEM_CONTROL-DELIV_ITEM = LS_BATCH-POSNR.
        GS_ITEM_CONTROL-CHG_DELQTY = GC_X.
        APPEND GS_ITEM_CONTROL TO GT_ITEM_CONTROL.

*        "저장위치
*        CLEAR GS_ITEM_DATA_SPL.
*        GS_ITEM_DATA_SPL-DELIV_NUMB = LS_LIPS-VBELN.
*        GS_ITEM_DATA_SPL-DELIV_ITEM = LS_BATCH-POSNR.
*        GS_ITEM_DATA_SPL-STGE_LOC   = LS_BATCH-LGORT.
*        APPEND GS_ITEM_DATA_SPL TO GT_ITEM_DATA_SPL.

      ENDLOOP.

    ENDIF.

*---BATCH SPLIT 변경
    IF LINE_EXISTS( IT_BATCH[ VBELN = LS_ITEM-VBELN
                              UECHA = LS_ITEM-POSNR
                              UPDKZ = GC_U          ] ).
      LV_H = GC_X.

      LOOP AT IT_BATCH INTO LS_BATCH WHERE VBELN = LS_ITEM-VBELN
                                       AND UECHA = LS_ITEM-POSNR
                                       AND UPDKZ = GC_U.

        CLEAR:GS_ITEM_DATA,GS_ITEM_CONTROL.

        LV_SUM_INPT = LV_SUM_INPT + LS_BATCH-LFIMG.

        GS_ITEM_DATA-DELIV_NUMB      = LS_LIPS-VBELN.
        GS_ITEM_DATA-DELIV_ITEM      = LS_BATCH-POSNR.
        GS_ITEM_DATA-MATERIAL_LONG   = LS_BATCH-MATNR.
        GS_ITEM_DATA-BATCH           = LS_BATCH-CHARG.
        GS_ITEM_DATA-HIERARITEM      = LS_BATCH-UECHA.
        GS_ITEM_DATA-USEHIERITM      = '1'.
        GS_ITEM_DATA-DLV_QTY         = LS_BATCH-LFIMG.
        GS_ITEM_DATA-SALES_UNIT      = LS_ITEM-VRKME.
        GS_ITEM_DATA-FACT_UNIT_NOM   = LS_LIPS-UMVKZ.
        GS_ITEM_DATA-FACT_UNIT_DENOM = LS_LIPS-UMVKN.
        GS_ITEM_DATA-CONV_FACT       = LS_LIPS-UMREF.
        APPEND GS_ITEM_DATA TO GT_ITEM_DATA.

        GS_ITEM_CONTROL-DELIV_NUMB = LS_LIPS-VBELN.
        GS_ITEM_CONTROL-DELIV_ITEM = LS_BATCH-POSNR.
        GS_ITEM_CONTROL-CHG_DELQTY = GC_X.
        APPEND GS_ITEM_CONTROL TO GT_ITEM_CONTROL.

*        "저장위치
*        CLEAR LS_LIPS.
*        LS_LIPS = VALUE #( GT_LIPS[ VBELN = LS_BATCH-VBELN
*                                    POSNR = LS_BATCH-POSNR ] OPTIONAL ).
*        IF LS_LIPS-LGORT NE LS_BATCH-LGORT.
*          CLEAR GS_ITEM_DATA_SPL.
*          GS_ITEM_DATA_SPL-DELIV_NUMB = LS_BATCH-VBELN.
*          GS_ITEM_DATA_SPL-DELIV_ITEM = LS_BATCH-POSNR.
*          GS_ITEM_DATA_SPL-STGE_LOC   = LS_BATCH-LGORT.
*          APPEND GS_ITEM_DATA_SPL TO GT_ITEM_DATA_SPL.
*        ENDIF.
      ENDLOOP.
    ENDIF.

    "생성/변경
    IF LV_H EQ GC_X OR LV_V EQ GC_X.
      CLEAR:GS_ITEM_DATA.

      GS_ITEM_DATA-DELIV_NUMB      = LS_LIPS-VBELN.
      GS_ITEM_DATA-DELIV_ITEM      = LS_LIPS-POSNR.
      GS_ITEM_DATA-MATERIAL_LONG   = LS_LIPS-MATNR.
      GS_ITEM_DATA-BATCH           = LS_ITEM-CHARG.
      GS_ITEM_DATA-DLV_QTY         = LS_ITEM-LFIMG.
      GS_ITEM_DATA-SALES_UNIT      = LS_ITEM-VRKME.
      GS_ITEM_DATA-FACT_UNIT_NOM   = LS_LIPS-UMVKZ.
      GS_ITEM_DATA-FACT_UNIT_DENOM = LS_LIPS-UMVKN.
      GS_ITEM_DATA-CONV_FACT       = LS_LIPS-UMREF.
      APPEND GS_ITEM_DATA TO GT_ITEM_DATA.

    ENDIF.

    "삭제
    IF LV_D EQ GC_X.
      CLEAR:GS_ITEM_DATA.

      GS_ITEM_DATA-DELIV_NUMB      = LS_LIPS-VBELN.
      GS_ITEM_DATA-DELIV_ITEM      = LS_LIPS-POSNR.
      GS_ITEM_DATA-MATERIAL_LONG   = LS_ITEM-MATNR.
      GS_ITEM_DATA-BATCH           = LS_ITEM-CHARG.
      GS_ITEM_DATA-DLV_QTY         = LS_ITEM-LFIMG.
      GS_ITEM_DATA-SALES_UNIT      = LS_ITEM-VRKME.
      GS_ITEM_DATA-FACT_UNIT_NOM   = LS_LIPS-UMVKZ.
      GS_ITEM_DATA-FACT_UNIT_DENOM = LS_LIPS-UMVKN.
      GS_ITEM_DATA-CONV_FACT       = LS_LIPS-UMREF.
      APPEND GS_ITEM_DATA TO GT_ITEM_DATA.
    ENDIF.

    CLEAR LS_LIPS.
  ENDLOOP.

  IF GT_ITEM_DATA[] IS INITIAL.
    E_TYPE = GC_E.
    E_MSG  = TEXT-M07.
    EXIT.
  ENDIF.


*-BAPI 수행

  "HEADER
  GS_HEADER_DATA-DELIV_NUMB    = GS_LIKP-VBELN.
  GS_HEADER_CONTROL-DELIV_NUMB = GS_LIKP-VBELN.

  CALL FUNCTION 'RV_DELIVERY_INIT'
    EXPORTING
      IF_NO_DEQUE = GC_X.

  CALL FUNCTION 'BAPI_OUTB_DELIVERY_CHANGE'
    EXPORTING
      HEADER_DATA    = GS_HEADER_DATA
      HEADER_CONTROL = GS_HEADER_CONTROL
      DELIVERY       = GS_LIKP-VBELN
    TABLES
      ITEM_DATA      = GT_ITEM_DATA
      ITEM_CONTROL   = GT_ITEM_CONTROL
      ITEM_DATA_SPL  = GT_ITEM_DATA_SPL
      RETURN         = GT_RETURN.

  DATA: LV_MESSAGE(100).
  LOOP AT GT_RETURN INTO DATA(LS_RETURN) WHERE TYPE CA 'AEX'.
    CLEAR LV_MESSAGE.
    CALL FUNCTION 'MESSAGE_TEXT_BUILD'
          EXPORTING
            MSGID               = LS_RETURN-ID
            MSGNR               = LS_RETURN-NUMBER
            MSGV1               = LS_RETURN-MESSAGE_V1
            MSGV2               = LS_RETURN-MESSAGE_V2
            MSGV3               = LS_RETURN-MESSAGE_V3
            MSGV4               = LS_RETURN-MESSAGE_V4
          IMPORTING
            MESSAGE_TEXT_OUTPUT = LV_MESSAGE.
    IF LV_MSG IS INITIAL.
      LV_MSG = LV_MESSAGE.
    ELSE.
      LV_MSG = |{ LV_MSG }/{ LV_MESSAGE }|.
    ENDIF.
  ENDLOOP.

  IF SY-SUBRC EQ 0.
    __BAPI_TRANSACTION_ROLLBACK.

    E_TYPE = GC_E.
    E_MSG   = |{ TEXT-M65 }:{ LV_MSG }|.
  ELSE.
    __BAPI_TRANSACTION_COMMIT.

    E_TYPE = GC_S.
    E_MSG   = TEXT-S01.
  ENDIF.

ENDFUNCTION.

FORM GET_DO_INFO USING PV_VBELN.

*-LIKP
  SELECT SINGLE *
    FROM LIKP
   WHERE VBELN EQ @PV_VBELN
    INTO @GS_LIKP.

  CHECK SY-SUBRC EQ 0.

*-LIPS
  SELECT *
    FROM LIPS
   WHERE VBELN EQ @PV_VBELN
    INTO TABLE @GT_LIPS.
ENDFORM.
FORM INIT_PARAMETRS.
  CLEAR:GS_HEADER_DATA,GS_HEADER_CONTROL,
        GV_DELIVERY.

  REFRESH: GT_ITEM_DATA,GT_ITEM_CONTROL,GT_ITEM_DATA_SPL,
           GT_RETURN.
ENDFORM.
