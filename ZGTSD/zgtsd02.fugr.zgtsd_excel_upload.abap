FUNCTION ZGTSD_EXCEL_UPLOAD.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_FILENAME) TYPE  STRING
*"     REFERENCE(IV_BEGIN_COL) TYPE  INT4
*"     REFERENCE(IV_BEGIN_ROW) TYPE  INT4
*"     REFERENCE(IV_END_COL) TYPE  INT4 DEFAULT 256
*"     REFERENCE(IV_END_ROW) TYPE  INT4 DEFAULT 131072
*"     REFERENCE(IV_FIRST_SHEET) TYPE  CHAR1 DEFAULT 'X'
*"     REFERENCE(IV_SHEET_NO) TYPE  INT4 OPTIONAL
*"  EXPORTING
*"     REFERENCE(EV_SEPARATOR) TYPE  CHAR1
*"  TABLES
*"      ET_EXCEL_TAB STRUCTURE  BAPIXMSPOW
*"  EXCEPTIONS
*"      INCONSISTENT_PARAMETERS
*"      UPLOAD_OLE
*"----------------------------------------------------------------------


* Global data declarations

  DATA: LO_APPLICATION TYPE OLE2_OBJECT,
        LO_WORKBOOK    TYPE OLE2_OBJECT,
        LO_WORKSHEET   TYPE OLE2_OBJECT,
        LO_RANGE       TYPE OLE2_OBJECT,
        LO_START_CELL  TYPE OLE2_OBJECT,
        LO_END_CELL    TYPE OLE2_OBJECT,
        LO_END         TYPE OLE2_OBJECT,
        LV_SHEET_NO    TYPE INT1.

*-----------------------------------------------------------------------
  DEFINE __LOC_XLS_MSG.
    CASE SY-SUBRC.
      WHEN 0.
      WHEN 1.
        MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
              WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
      WHEN OTHERS.
        RAISE UPLOAD_OLE.
    ENDCASE.
  END-OF-DEFINITION.
*-----------------------------------------------------------------------

  CLEAR ET_EXCEL_TAB[].

  IF IV_BEGIN_COL GT IV_END_COL. RAISE INCONSISTENT_PARAMETERS. ENDIF.

  IF IV_END_ROW NE 0.
    IF IV_BEGIN_ROW GT IV_END_ROW. RAISE INCONSISTENT_PARAMETERS. ENDIF.
  ENDIF.

  IF IV_SHEET_NO GT 0.
    LV_SHEET_NO = IV_SHEET_NO. "시트
  ELSE.
    IF IV_FIRST_SHEET EQ ABAP_TRUE.
      LV_SHEET_NO = 1.
    ENDIF.
  ENDIF.

  IF LO_APPLICATION-HEADER EQ SPACE OR LO_APPLICATION-HANDLE EQ -1.
    CREATE OBJECT LO_APPLICATION 'EXCEL.APPLICATION'.
    __LOC_XLS_MSG.
  ENDIF.

  CALL METHOD OF LO_APPLICATION 'WORKBOOKS' = LO_WORKBOOK.
  __LOC_XLS_MSG.

  CALL METHOD OF LO_WORKBOOK 'OPEN'
    EXPORTING
      #1 = IV_FILENAME.
  IF SY-SUBRC NE 0.
    MESSAGE I077(SRF_RUNTIME) WITH IV_FILENAME. "파일 &1을(를) 열 수 없습니다.
    EXIT.
  ENDIF.

  IF LV_SHEET_NO GT 0.
    CALL METHOD OF LO_APPLICATION 'WORKSHEETS' = LO_WORKSHEET
      EXPORTING
        #1 = LV_SHEET_NO. "시트
    IF SY-SUBRC NE 0 AND SY-SUBRC NE 1.
      CALL METHOD OF LO_WORKBOOK 'CLOSE'.
      CALL METHOD OF LO_APPLICATION 'QUIT'.
      FREE OBJECT LO_WORKBOOK.
      FREE OBJECT LO_APPLICATION.
      RAISE UPLOAD_OLE.
    ENDIF.

    CALL METHOD OF LO_WORKSHEET 'ACTIVATE'.

  ELSE.
    GET PROPERTY OF LO_APPLICATION 'ACTIVESHEET' = LO_WORKSHEET.

  ENDIF.
  __LOC_XLS_MSG.

  IF IV_SHEET_NO GT 0.
    CL_PROGRESS_INDICATOR=>PROGRESS_INDICATE(
      I_TEXT               = |Uploading sheet #{ IV_SHEET_NO }...|
      I_OUTPUT_IMMEDIATELY = ABAP_TRUE ).
  ENDIF.

  CALL METHOD OF LO_WORKSHEET 'CELLS' = LO_START_CELL
    EXPORTING
      #1           = IV_BEGIN_ROW
      #2           = IV_BEGIN_COL.
  __LOC_XLS_MSG.


  IF IV_END_ROW NE 0.
    CALL METHOD OF LO_WORKSHEET 'CELLS' = LO_END_CELL
      EXPORTING
        #1           = IV_END_ROW                           "172760
        #2           = IV_END_COL. "5.
    __LOC_XLS_MSG.

* Creating range with starting cell and ending cell
    CALL METHOD OF LO_WORKSHEET 'RANGE' = LO_RANGE
      EXPORTING
        #1 = LO_START_CELL
        #2 = LO_END_CELL.
  ELSE.

* End Cell 정보로 Select 하기..
    GET PROPERTY OF LO_APPLICATION 'ACTIVECELL' = LO_END_CELL.

* Getting the last cell that is filled with data ( CTRL + END )
    CALL METHOD OF LO_END_CELL 'SPECIALCELLS' = LO_END
      EXPORTING
        #1 = '11'. "'11'. " Value for constant 'xlLastCell'

* Creating range with starting cell and ending cell
    CALL METHOD OF LO_WORKSHEET 'RANGE' = LO_RANGE
      EXPORTING
        #1 = LO_START_CELL
        #2 = LO_END.
  ENDIF.


  CALL METHOD OF LO_RANGE 'SELECT'.
  __LOC_XLS_MSG.

  CALL METHOD OF LO_RANGE 'COPY'.
  __LOC_XLS_MSG.


* Without flush, CLIPBOARD_IMPORT does not find the data
  CALL FUNCTION 'CONTROL_FLUSH'
    EXCEPTIONS
      OTHERS = 3.


* Read clipboard into ABAP
  CALL METHOD CL_GUI_FRONTEND_SERVICES=>CLIPBOARD_IMPORT
    IMPORTING
      DATA                 = ET_EXCEL_TAB[]
    EXCEPTIONS
      CNTL_ERROR           = 1
      ERROR_NO_GUI         = 2
      NOT_SUPPORTED_BY_GUI = 3
      OTHERS               = 4.
  IF SY-SUBRC NE 0.
    " 클립보드내용의 Import중에 오류가 발생했습니다
    MESSAGE I037(ALSMEX).
    EXIT.
  ENDIF.


  EV_SEPARATOR = CL_ABAP_CHAR_UTILITIES=>HORIZONTAL_TAB.

  SET PROPERTY OF LO_APPLICATION 'CutCopyMode' = 0.
  __LOC_XLS_MSG.

  CALL METHOD OF LO_WORKBOOK 'CLOSE'.

  CALL METHOD OF LO_APPLICATION 'QUIT'.
  __LOC_XLS_MSG.

  FREE OBJECT LO_START_CELL.
  FREE OBJECT LO_END_CELL.
  IF LO_END IS NOT INITIAL.  FREE OBJECT LO_END.  ENDIF.
  FREE OBJECT LO_RANGE.
  FREE OBJECT LO_WORKSHEET.
  FREE OBJECT LO_WORKBOOK .
  FREE OBJECT LO_APPLICATION.
  __LOC_XLS_MSG.

ENDFUNCTION.
