*&---------------------------------------------------------------------*
*& Module SCREEN_OUTPUT_0200 OUTPUT
*&---------------------------------------------------------------------*
*&
*&---------------------------------------------------------------------*
MODULE SCREEN_OUTPUT_0200 OUTPUT.
  LOOP AT SCREEN.
    IF SCREEN-GROUP1 EQ 'ZG1'.
      IF GV_FLAG_FKDAT IS NOT INITIAL.
        SCREEN-INPUT = 1.
      ELSE.
        SCREEN-INPUT = 0.
      ENDIF.
    ENDIF.
    MODIFY SCREEN.
  ENDLOOP.
ENDMODULE.
