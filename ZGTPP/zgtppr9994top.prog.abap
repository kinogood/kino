*&---------------------------------------------------------------------*
*& Include          ZGTPPR9994TOP
*&---------------------------------------------------------------------*

TYPE-POOLS : SLIS.
INCLUDE <CL_ALV_CONTROL>.
TABLES : MARA, MARC, MAST.

DATA : BEGIN OF GS_MAIN_DISP,
         STATUS  LIKE ICON-ID,
         MESSAGE LIKE BAPIRET2-MESSAGE,
         WERKS   LIKE MARC-WERKS,
         NAME1   LIKE T001W-NAME1,
         MATNR_O LIKE MARC-MATNR,
         MAKTX_O LIKE MAKT-MAKTX,
         MTART_O LIKE MARA-MTART,
         MATKL_O LIKE MARA-MATKL,
         IDNRK   LIKE STPO-IDNRK,
         MAKTX   LIKE MAKT-MAKTX,
         MTART   LIKE MARA-MTART,
         MATKL   LIKE MARA-MATKL,
         STLAN   LIKE MAST-STLAN,
         STLAL   LIKE MAST-STLAL,
         ANDAT   LIKE MAST-ANDAT,
         CELLTAB TYPE LVC_T_STYL,
       END OF GS_MAIN_DISP.
DATA : GT_MAIN_DISP LIKE TABLE OF GS_MAIN_DISP.

* 팝업 결과 변수
DATA : GV_ANSWER TYPE CHAR01.

DATA: GV_OK_CODE LIKE SY-UCOMM.

*-/ ALV Global Field
CLASS LCL_EVENT_HANDLER DEFINITION DEFERRED.
DATA : GO_EVENT_HANDLER TYPE REF TO LCL_EVENT_HANDLER.

*ALV GRID 100
DATA : GO_CONTAIN_0100 TYPE REF TO CL_GUI_DOCKING_CONTAINER.
DATA : GO_GRID_0100 TYPE REF TO CL_GUI_ALV_GRID.
DATA : GS_VARIANT TYPE DISVARIANT.
DATA : GS_LAYOUT_0100 TYPE LVC_S_LAYO.
DATA : GT_SORT_0100 TYPE LVC_T_SORT.
DATA : GT_EXCLUDE_0100 TYPE UI_FUNCTIONS.
DATA : GT_FIELDCAT_0100 TYPE LVC_T_FCAT.

* BDC 테이블
DATA GS_BDCPARAMS TYPE CTU_PARAMS .
DATA GS_BDCDATA TYPE BDCDATA .
DATA : GT_BDCDATA TYPE TABLE OF BDCDATA .
DATA : GT_MESSTAB TYPE TABLE OF BDCMSGCOLL .

DEFINE __SETTING_BDC_PARAMS.
  CLEAR: GS_BDCPARAMS.
  GS_BDCPARAMS-DISMODE  = 'N'.   " 처리모드
  GS_BDCPARAMS-UPDMODE  = 'A'.   " 갱신세션
  GS_BDCPARAMS-DEFSIZE  = 'X'.   " 기본화면
  GS_BDCPARAMS-RACOMMIT = 'X'.   " COMMAND 이후 지속
  GS_BDCPARAMS-NOBINPT  = 'X'.   " BI 세션
END-OF-DEFINITION.

DEFINE __BDC_DYNPRO.
  CLEAR GS_BDCDATA.
  GS_BDCDATA-PROGRAM  = &1.
  GS_BDCDATA-DYNPRO   = &2.
  GS_BDCDATA-DYNBEGIN = 'X'.
  APPEND GS_BDCDATA TO GT_BDCDATA.
END-OF-DEFINITION.

DEFINE __BDC_FIELD.
  CLEAR GS_BDCDATA.
  GS_BDCDATA-FNAM = &1.
  GS_BDCDATA-FVAL = CONV #( &2 ).
  APPEND GS_BDCDATA TO GT_BDCDATA.
END-OF-DEFINITION.


DEFINE __BDC_TRANSACTION.
  CALL TRANSACTION &1 USING GT_BDCDATA
                              OPTIONS FROM GS_BDCPARAMS
                            MESSAGES INTO GT_MESSTAB.
END-OF-DEFINITION.
