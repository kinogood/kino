     <FUNCNAME>ZGTPP_UTILL_TEXTEDIT</FUNCNAME>
     <REMOTE_CALL>R</REMOTE_CALL>
     <SHORT_TEXT>[GT] Text Edit</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_MODE</PARAMETER>
       <DEFAULT>&apos;1&apos;</DEFAULT>
       <OPTIONAL>X</OPTIONAL>
       <TYP>CHAR01</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_TITLE</PARAMETER>
       <TYP>SY-TITLE</TYP>
      </RSIMP>
     </IMPORT>
     <CHANGING>
      <RSCHA>
       <PARAMETER>CT_TEXT</PARAMETER>
       <TYP>TCHAR255</TYP>
      </RSCHA>
     </CHANGING>
     <DOCUMENTATION>
      <RSFDO>
       <PARAMETER>IV_MODE</PARAMETER>
       <KIND>P</KIND>
       <STEXT>&apos;1&apos; Disp, &apos;2&apos; Edit</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>IV_TITLE</PARAMETER>
       <KIND>P</KIND>
       <STEXT>ABAP System Field: Title Line Content of Current Dynpro</STEXT>
      </RSFDO>
      <RSFDO>
       <PARAMETER>CT_TEXT</PARAMETER>
       <KIND>P</KIND>
       <STEXT>Table of CHAR255</STEXT>
      </RSFDO>
     </DOCUMENTATION>
    </item>
