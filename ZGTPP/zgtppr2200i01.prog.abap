MODULE exit INPUT.

  PERFORM user_command_exit.

ENDMODULE.
*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_100  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_100 INPUT.

  CASE gv_okcode.
    WHEN gc_fcode-back OR gc_fcode-exit. "// Back, Exit.
      PERFORM user_command_exit.

    WHEN gc_fcode-save.                  "// 저장.
      PERFORM user_command_save.
  ENDCASE.

  CLEAR gv_okcode.

ENDMODULE.
