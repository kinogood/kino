*&---------------------------------------------------------------------*
*& Include          ZXCO1U11
*&---------------------------------------------------------------------*
DATA: L_ZZPRIORITY  TYPE CI_AUFK-ZZPRIORITY,
      L_ZZORIGIN    TYPE CI_AUFK-ZZORIGIN,
      L_ZZFOLLOWING TYPE CI_AUFK-ZZFOLLOWING,
      L_ZZBUNDLE TYPE CI_AUFK-ZZBUNDLE,
      L_ZZPOSNR TYPE CI_AUFK-ZZPOSNR,
      l_ZZTANDEM    TYPE CI_AUFK-ZZTANDEM,
      l_ZZCUT_REQ    TYPE CI_AUFK-ZZCUT_REQ.

IF SY-TCODE = 'CO03'.
  SELECT SINGLE ZZPRIORITY ZZORIGIN ZZFOLLOWING ZZBUNDLE ZZPOSNR ZZTANDEM ZZCUT_REQ
    FROM AUFK
    INTO (L_ZZPRIORITY, L_ZZORIGIN, L_ZZFOLLOWING, L_ZZBUNDLE, L_ZZPOSNR, l_ZZTANDEM, l_ZZCUT_REQ)
   WHERE AUFNR = I_CAUFVD-AUFNR.

  IF SY-SUBRC = 0.
    GV_ZZPRIORITY  = L_ZZPRIORITY.
    GV_ZZORIGIN    = L_ZZORIGIN.
    GV_ZZFOLLOWING = L_ZZFOLLOWING.
    GV_ZZBUNDLE = L_ZZBUNDLE.
    GV_ZZPOSNR = L_ZZPOSNR.
    GV_ZZTANDEM = l_ZZTANDEM.
    GV_ZZCUT_REQ = l_ZZCUT_REQ.
  ENDIF.

ELSE.
  GV_ZZPRIORITY  = I_CAUFVD-ZZPRIORITY.
  GV_ZZORIGIN    = I_CAUFVD-ZZORIGIN.
  GV_ZZFOLLOWING = I_CAUFVD-ZZFOLLOWING.
  GV_ZZBUNDLE = I_CAUFVD-ZZBUNDLE.
  GV_ZZPOSNR = I_CAUFVD-ZZPOSNR.
  GV_ZZTANDEM = I_CAUFVD-ZZTANDEM.
  GV_ZZCUT_REQ = l_ZZCUT_REQ.
ENDIF.
