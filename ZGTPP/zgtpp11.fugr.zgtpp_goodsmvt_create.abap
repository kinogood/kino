FUNCTION ZGTPP_GOODSMVT_CREATE.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(GOODSMVT_HEADER) TYPE  BAPI2017_GM_HEAD_01
*"     VALUE(GOODSMVT_CODE) TYPE  BAPI2017_GM_CODE
*"  EXPORTING
*"     VALUE(EV_TYPE) TYPE  CHAR01
*"     VALUE(EV_MESSAGE) TYPE  ZGTPPT2460-STAT_MSG
*"     VALUE(EV_MBLNR) TYPE  MSEG-MBLNR
*"     VALUE(EV_MJAHR) TYPE  MSEG-MJAHR
*"  TABLES
*"      GOODSMVT_ITEM STRUCTURE  BAPI2017_GM_ITEM_CREATE OPTIONAL
*"----------------------------------------------------------------------

  DATA : LT_RETURN TYPE TABLE OF BAPIRET2.
  DATA : LS_GMHEADRET LIKE BAPI2017_GM_HEAD_RET.

  CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
    EXPORTING
      GOODSMVT_HEADER  = GOODSMVT_HEADER
      GOODSMVT_CODE    = GOODSMVT_CODE
    IMPORTING
      GOODSMVT_HEADRET = LS_GMHEADRET
    TABLES
      GOODSMVT_ITEM    = GOODSMVT_ITEM
      RETURN           = LT_RETURN.

  IF LS_GMHEADRET IS INITIAL.
    EV_TYPE = 'E'.
    READ TABLE LT_RETURN INTO DATA(LS_RETURN) WITH KEY TYPE = 'E'.
    EV_MESSAGE = LS_RETURN-MESSAGE.

  ELSE.
*- 성공
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        WAIT = 'X'.
    EV_MBLNR = LS_GMHEADRET-MAT_DOC.
    EV_MJAHR = LS_GMHEADRET-DOC_YEAR.

  ENDIF.

ENDFUNCTION.
