@AbapCatalog.sqlViewName: 'ZGTCVORDSYVAL'
@AbapCatalog.compiler.compareFilter: true
@AbapCatalog.preserveKey: true
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: '생산오더 특성값'
@ClientHandling.algorithm: #SESSION_VARIABLE
define view ZGTPP_CV_ORDSYVAL as 
select from zgtiordsyval
{
    key werks,
    key auart,
    key aufnr,
    key posnr,
    terkz,
    gstrp,
    gsuzp,
    gltrp,
    gluzp,
    gamng,
    gasmg,
    gmein,
    matnr,
    maktx,
    dispo,
    psmng,
    psamg,
    wemng,
    meins,
    grpnr,
    max(millcalength) as MillCaLength,
    max(millcafactor) as MillCaFactor,
    inlength,
    infactor,
    qlength,
    clength,
    adlength,
    adtype,    
    elikz,
    dmord,
    dmline,
    gong_seq,
    zzpriority,
    zzorigin,
    zzfollowing,
    zzbundle,
    zzposnr,
    zzkdauf,
    zzkdpos,
    zztandem,
    kdauf,
    kdpos,
    kunnr,    
    name1,
    zpjno,
    zptxt,
    objnr,
    cuobj,
    max(millcapackcat) as MillCaPackCat,   
    max(millcapackcatnm) as MillCaPackCatNm,
    max(millcapacking) as MillCaPacking,                
    max(pdcapackingdm) as PdCaPackingDm,                
    max(pdcapackingbx) as PdCaPackingBx,
    max(pdcavoltage) as PdCaVoltage,
    max(pdcainxnumthick) as PdCaInxNumThick,
    max(pdcacoretype1st) as PdCaCoreType1st,
    max(pdcacondsize1st) as PdCaCondSize1st,
    max(pdpcshethick) as PdPcSheThick,
    max(pdcaprocoutdia) as PdCaProcOutDia,  
    max(pdcaprocoutdialong) as PdCaProcOutDiaLong,
    max(pdcaproccode) as PdCaProcCode,          
    max(pdcaprocname) as PdCaProcName,
    max(pdpcdrydayno) as PdPcDryDayNo,
    erdat,
    aedat,
    arbpl,
    ktext,
    rel,
    dlfl,
    lkd,
    teco,
    clsd,
    pcnf,
    cnf,
    pdlv,
    dlv
}
group by werks, auart, aufnr, posnr, terkz, gstrp, gsuzp, gltrp, gluzp, gamng, gasmg, gmein,
         matnr, maktx, dispo, psmng, psamg, wemng, meins, grpnr, elikz, zzpriority, zzorigin, 
         kdauf, kdpos, kunnr, name1, zpjno, zptxt, objnr, cuobj, erdat, aedat, arbpl, ktext,
         inlength, infactor, qlength, clength, adlength, adtype, dmord, dmline, gong_seq,
         rel, dlfl, lkd, teco, clsd, pcnf, cnf, pdlv, dlv,
         zzfollowing, zzbundle, zzposnr, zzkdauf, zzkdpos, zztandem
