FORM GET_DATA_ZGTPPV1170.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZGTPPT1170 WHERE
(VIM_WHERETAB) .
    CLEAR ZGTPPV1170 .
ZGTPPV1170-MANDT =
ZGTPPT1170-MANDT .
ZGTPPV1170-WERKS =
ZGTPPT1170-WERKS .
ZGTPPV1170-MATNR =
ZGTPPT1170-MATNR .
    SELECT SINGLE * FROM MARA WHERE
MATNR = ZGTPPT1170-MATNR .
    IF SY-SUBRC EQ 0.
      SELECT SINGLE * FROM MAKT WHERE
MATNR = MARA-MATNR AND
SPRAS = SY-LANGU .
      IF SY-SUBRC EQ 0.
ZGTPPV1170-MAKTX =
MAKT-MAKTX .
      ENDIF.
    ENDIF.
<VIM_TOTAL_STRUC> = ZGTPPV1170.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZGTPPV1170 .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZGTPPV1170.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZGTPPV1170-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZGTPPT1170 WHERE
  WERKS = ZGTPPV1170-WERKS AND
  MATNR = ZGTPPV1170-MATNR .
    IF SY-SUBRC = 0.
    DELETE ZGTPPT1170 .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZGTPPT1170 WHERE
  WERKS = ZGTPPV1170-WERKS AND
  MATNR = ZGTPPV1170-MATNR .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZGTPPT1170.
    ENDIF.
ZGTPPT1170-MANDT =
ZGTPPV1170-MANDT .
ZGTPPT1170-WERKS =
ZGTPPV1170-WERKS .
ZGTPPT1170-MATNR =
ZGTPPV1170-MATNR .
    IF SY-SUBRC = 0.
    UPDATE ZGTPPT1170 ##WARN_OK.
    ELSE.
    INSERT ZGTPPT1170 .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZGTPPV1170-UPD_FLAG,
STATUS_ZGTPPV1170-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
