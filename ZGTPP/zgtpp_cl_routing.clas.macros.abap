*"* in the implementation part of the class
DEFINE __SETTING_BDC_PARAMS.
  CLEAR: MS_BDCPARAMS.
  MS_BDCPARAMS-DISMODE  = 'N'.   " 처리모드
  MS_BDCPARAMS-UPDMODE  = 'S'.   " 갱신세션
*  MS_BDCPARAMS-CATTMODE = ''.   " CATT모드
  MS_BDCPARAMS-DEFSIZE  = 'X'.   " 기본화면
**  MS_BDCPARAMS-RACOMMIT = 'X'.   " COMMAND 이후 지속
**  MS_BDCPARAMS-NOBINPT  = ' '.   " BI 세션
END-OF-DEFINITION.

DEFINE __BDC_DYNPRO.
  CLEAR MS_BDCDATA.
  MS_BDCDATA-PROGRAM  = &1.
  MS_BDCDATA-DYNPRO   = &2.
  MS_BDCDATA-DYNBEGIN = 'X'.
  APPEND MS_BDCDATA TO MT_BDCDATA.
END-OF-DEFINITION.

DEFINE __BDC_FIELD.
  CLEAR MS_BDCDATA.
  MS_BDCDATA-FNAM = &1.
  MS_BDCDATA-FVAL = conv #( &2 ).
  APPEND MS_BDCDATA TO MT_BDCDATA.
END-OF-DEFINITION.


DEFINE __BDC_TRANSACTION.
  CALL TRANSACTION &1 USING MT_BDCDATA
                              OPTIONS FROM MS_BDCPARAMS
                            MESSAGES INTO MT_MESSTAB.
END-OF-DEFINITION.
