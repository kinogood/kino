FUNCTION ZGTPPT_BDC_PRD_CHART.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(IV_GUBUN) TYPE  CHAR01 OPTIONAL
*"  EXPORTING
*"     VALUE(EV_SUCCSEQ) TYPE  I
*"  TABLES
*"      IT_2010 STRUCTURE  ZGTPPT2010
*"      ET_MESSAGE STRUCTURE  BDCMSGCOLL
*"----------------------------------------------------------------------

  DATA : LV_INLENGTH TYPE I.
  DATA : LV_INLENGTH_C(10) TYPE C.
  DATA : LV_INFACTOR TYPE I.
  DATA : LV_INFACTOR_C(10) TYPE C.
  DATA : LV_FIELDNAME TYPE FNAM_____4.
  DATA : LV_NUM(2) TYPE N.

  DATA : LV_TEST01 TYPE CABNT-ATBEZ.
  DATA : LV_TEST02 TYPE CABNT-ATBEZ.
  DATA : LV_TEST03 TYPE CABNT-ATBEZ.

  DATA : LT_AFPO TYPE TABLE OF AFPO.

* BDC 테이블
  DATA : LS_BDCPARAMS TYPE CTU_PARAMS .
  DATA : LS_BDCDATA TYPE BDCDATA .
  DATA : LT_BDCDATA TYPE TABLE OF BDCDATA .
  DATA : LT_MESSTAB TYPE TABLE OF BDCMSGCOLL .
  DATA : LV_MESSAGE TYPE CHAR100.

  DEFINE __SETTING_BDC_PARAMS.
    CLEAR: LS_BDCPARAMS.
    LS_BDCPARAMS-DISMODE  = 'N'.   " 처리모드
    LS_BDCPARAMS-UPDMODE  = 'S'.   " 갱신세션
*  MS_BDCPARAMS-CATTMODE = ''.   " CATT모드
    LS_BDCPARAMS-DEFSIZE  = 'X'.   " 기본화면
**  MS_BDCPARAMS-RACOMMIT = 'X'.   " COMMAND 이후 지속
**  MS_BDCPARAMS-NOBINPT  = ' '.   " BI 세션
  END-OF-DEFINITION.

  DEFINE __BDC_DYNPRO.
    CLEAR LS_BDCDATA.
    LS_BDCDATA-PROGRAM  = &1.
    LS_BDCDATA-DYNPRO   = &2.
    LS_BDCDATA-DYNBEGIN = 'X'.
    APPEND LS_BDCDATA TO LT_BDCDATA.
  END-OF-DEFINITION.

  DEFINE __BDC_FIELD.
    CLEAR LS_BDCDATA.
    LS_BDCDATA-FNAM = &1.
    LS_BDCDATA-FVAL = conv #( &2 ).
    APPEND LS_BDCDATA TO LT_BDCDATA.
  END-OF-DEFINITION.


  DEFINE __BDC_TRANSACTION.
    CALL TRANSACTION &1 USING LT_BDCDATA
                                OPTIONS FROM lS_BDCPARAMS
                              MESSAGES INTO LT_MESSTAB.
  END-OF-DEFINITION.

  SELECT A~ATNAM, B~ATBEZ
    FROM CABN AS A
    INNER JOIN CABNT AS B ON B~ATINN = A~ATINN
  WHERE A~ATNAM IN ( 'SAP_MILLCA_LENGTH', 'SAP_MILLCA_FACTOR', 'PD_CA_PROC_NAME' )
    AND B~SPRAS = @SY-LANGU
   INTO TABLE @DATA(LT_CHAR_NAME).

  LOOP AT LT_CHAR_NAME INTO DATA(LS_CHAR_NAME).
    CASE LS_CHAR_NAME-ATNAM.
      WHEN 'SAP_MILLCA_LENGTH'.
        LV_TEST01 = LS_CHAR_NAME-ATBEZ.
      WHEN 'SAP_MILLCA_FACTOR'.
        LV_TEST02 = LS_CHAR_NAME-ATBEZ.
      WHEN 'PD_CA_PROC_NAME'.
        LV_TEST03 = LS_CHAR_NAME-ATBEZ.
    ENDCASE.
  ENDLOOP.

  __SETTING_BDC_PARAMS.

  LOOP AT IT_2010 INTO DATA(LS_2010).

    REFRESH LT_AFPO.
    SELECT AUFNR, POSNR, PSMNG, AMEIN
        FROM AFPO
       WHERE AUFNR = @LS_2010-ORDNR
        INTO CORRESPONDING FIELDS OF TABLE @LT_AFPO.

    SORT LT_AFPO BY POSNR.

    CLEAR : LV_INLENGTH, LV_INLENGTH_C.
    LV_INLENGTH = LS_2010-INLENGTH.
    LV_INLENGTH_C = LV_INLENGTH.
    CONDENSE LV_INLENGTH_C.

    CLEAR : LV_INFACTOR, LV_INFACTOR_C.
    LV_INFACTOR = LS_2010-INFACTOR.
    LV_INFACTOR_C = LV_INFACTOR.
    CONDENSE LV_INFACTOR_C.

    REFRESH : LT_BDCDATA, LT_MESSTAB.


    __BDC_DYNPRO 'SAPLCOKO1' '0110'.
    __BDC_FIELD : 'CAUFVD-AUFNR' LS_2010-ORDNR,
                        'R62CLORD-FLG_OVIEW'  'X',
                        'BDC_OKCODE' '=ENTK'.

    __BDC_DYNPRO 'SAPLCOKO1' '0115'.
    __BDC_FIELD : 'BDC_OKCODE' '=KOTA'. " 빠른입력화면으로 전환


    __BDC_DYNPRO 'SAPLCOKO1' '0115'.
    __BDC_FIELD :  'BDC_OKCODE' '=MILL_BT_SEL_ALL'.

    IF IV_GUBUN NE 'C'.
      __BDC_DYNPRO 'SAPLCOKO1' '0115'.
      __BDC_FIELD :  'BDC_OKCODE' '=MILL_BT_CONFIG'.
    ENDIF.

    __BDC_DYNPRO 'SAPLCOKO1' '0115'.
    __BDC_FIELD :  'BDC_OKCODE' '=MILL_BT_CONFIG'.

    LOOP AT LT_AFPO INTO DATA(LS_AFPO) .

      IF LS_AFPO-POSNR = LS_2010-POSNR+2(4).
        __BDC_DYNPRO 'SAPLCEI0' '0109'.
        __BDC_FIELD : 'RCTMS-MNAME(01)' LV_TEST01,
                            'RCTMS-MNAME(02)' LV_TEST02,
                            'RCTMS-MNAME(03)' LV_TEST03,
                            'RCTMS-MWERT(01)' LV_INLENGTH_C,
                            'RCTMS-MWERT(02)' LV_INFACTOR_C,
                            'RCTMS-MWERT(03)' LS_2010-GONG_CD,
                            'BDC_OKCODE' '=BACK'.
      ELSE.
        __BDC_DYNPRO 'SAPLCEI0' '0109'.
        __BDC_FIELD 'BDC_OKCODE' '=BACK'.
      ENDIF.

    ENDLOOP.

    __BDC_DYNPRO 'SAPLCOKO1' '0115'.
    __BDC_FIELD : 'BDC_OKCODE' '=BU'.

    __BDC_TRANSACTION 'CO02'.

    READ TABLE LT_MESSTAB INTO DATA(LS_MESSTAB) WITH KEY MSGID = 'CO'
                                                             MSGNR = '100'.
    IF SY-SUBRC EQ 0.
      ADD 1 TO EV_SUCCSEQ.
    ELSE.
      LV_MESSAGE = |생산오더({ LS_2010-ORDNR }) 특성값 입력 중 오류 발생하였습니다. - BDC' |.

      APPEND INITIAL LINE TO ET_MESSAGE ASSIGNING FIELD-SYMBOL(<LS_MESSTAB>).
      <LS_MESSTAB>-MSGV1 = LV_MESSAGE.
    ENDIF.

  ENDLOOP.

ENDFUNCTION.
