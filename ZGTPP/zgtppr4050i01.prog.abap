*----------------------------------------------------------------------*
MODULE USER_COMMAND_0100 INPUT.
  CASE GV_OK_CODE.
    WHEN 'DETAIL'.
      PERFORM PROCESS_DETAIL.      "상세조회
  ENDCASE.
ENDMODULE.
