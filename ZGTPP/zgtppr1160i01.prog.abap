MODULE exit INPUT.

  PERFORM user_command_exit.

ENDMODULE.
*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_100  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE user_command_100 INPUT.

  CASE gv_okcode.
*// Back, Exit.
    WHEN gc_fcode-back OR gc_fcode-exit.
      PERFORM user_command_exit.
  ENDCASE.

  CLEAR gv_okcode.

ENDMODULE.
