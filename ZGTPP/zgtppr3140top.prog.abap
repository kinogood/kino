* 인터페이스 리스트 마스터
DATA : BEGIN OF GS_IFLIST_MASTER,
         SEQNO       TYPE SEQNO,
         MODULE_KIND TYPE ZGTPPT1000-MODULE_KIND,
         CODEGRP     TYPE ZGTPPT1000-CODEGRP,
         DESC        TYPE ZGTPPT1010-FLD_01,
       END OF GS_IFLIST_MASTER.
DATA : GT_IFLIST_MASTER LIKE TABLE OF GS_IFLIST_MASTER.

* 인터페이스 리스트 ITEM
DATA : BEGIN OF GS_IFLIST_ITEM,
         FLD_01 TYPE ZGTPPT1010-FLD_01, " IF 항목
         FLD_02 TYPE ZGTPPT1010-FLD_02,  " IF 명
         FLD_13 TYPE ZGTPPT1010-FLD_13, "보관기간
       END OF GS_IFLIST_ITEM.
DATA : GT_IFLIST_ITEM LIKE TABLE OF GS_IFLIST_ITEM.

* 메인테이블
DATA : BEGIN OF GS_MAIN_DISP,
         MODULE_KIND LIKE ZGTPPT1010-MODULE_KIND,
         CODEGRP     LIKE ZGTPPT1010-CODEGRP,
         FLD_01      LIKE ZGTPPT1010-FLD_01,
         FLD_02      LIKE ZGTPPT1010-FLD_02,
         FLD_03      LIKE ZGTPPT1010-FLD_03,
         FLD_04      LIKE ZGTPPT1010-FLD_04,
         FLD_05      LIKE ZGTPPT1010-FLD_05,
         FLD_06      LIKE ZGTPPT1010-FLD_06,
         FLD_07      LIKE ZGTPPT1010-FLD_07,
         FLD_08      LIKE ZGTPPT1010-FLD_08,
         FLD_09      LIKE ZGTPPT1010-FLD_09,
         FLD_10      LIKE ZGTPPT1010-FLD_10,
         FLD_11      LIKE ZGTPPT1010-FLD_11,
         FLD_12      LIKE ZGTPPT1010-FLD_12,
         FLD_13      LIKE ZGTPPT3310-LOGDAY,
         STAT        LIKE ICON-ID,
         MSG         LIKE ZGTPPT3310-MSG,
       END OF GS_MAIN_DISP.
DATA : GT_MAIN_DISP LIKE TABLE OF GS_MAIN_DISP.

DATA : GT_SAVELOG TYPE TABLE OF ZGTPPT3310.

