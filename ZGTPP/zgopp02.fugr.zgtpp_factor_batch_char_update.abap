FUNCTION ZGTPP_FACTOR_BATCH_CHAR_UPDATE.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  TABLES
*"      T_INPUT TYPE  ZGTPPY0008
*"      T_OUTPUT TYPE  ZGTPPY0009
*"----------------------------------------------------------------------

  DATA : LT_INPUT TYPE ZGTPPY0008.
  DATA : LT_OUTPUT TYPE ZGTPPY0009.
  DATA: LT_RETURN  TYPE TABLE OF BAPIRET2,
        LV_CLASS   TYPE KLAH-CLASS,
        LT_VALNUM  TYPE TABLE OF BAPI1003_ALLOC_VALUES_NUM,
        LS_VALNUM  TYPE BAPI1003_ALLOC_VALUES_NUM,
        LT_VALCHAR TYPE TABLE OF BAPI1003_ALLOC_VALUES_CHAR,
        LS_VALCHAR TYPE BAPI1003_ALLOC_VALUES_CHAR,
        LT_VALCURR TYPE TABLE OF BAPI1003_ALLOC_VALUES_CURR,
        LV_STATUS  TYPE BAPI1003_KEY-STATUS.
  DATA: LV_HEADTEXT TYPE BKTXT.


  "단일 단위 배치 기본값
  LT_INPUT = T_INPUT[].
  SELECT A~*
    FROM @LT_INPUT AS A
    INNER JOIN MARC AS B ON B~MATNR = A~MATNR
                        AND B~WERKS = A~WERKS
   WHERE B~DPCBT = 'A'
    INTO CORRESPONDING FIELDS OF TABLE @LT_OUTPUT.

  LOOP AT LT_OUTPUT ASSIGNING FIELD-SYMBOL(<LS_OUTPUT>).
    CLEAR: LT_VALNUM, LT_VALCHAR, LT_VALCURR.

* CLASS번호
    CLEAR: LV_CLASS.
    CALL FUNCTION 'CLFC_BATCH_ALLOCATION_TO_CLASS'
      EXPORTING
        MATERIAL           = <LS_OUTPUT>-MATNR "입고자재
        PLANT              = <LS_OUTPUT>-WERKS "플랜트
        CLASSTYPE          = '023'       "클래스유형(배치)
      IMPORTING
        CLASS              = LV_CLASS
      EXCEPTIONS
        NO_CLASS_FOUND     = 1
        NO_CLASSTYPE_FOUND = 2
        OTHERS             = 3.

    IF SY-SUBRC NE 0.
      <LS_OUTPUT>-ZO_MESSAGE = '자재, 플랜트의 023 CLASS 추출 실패했습니다.'.
      <LS_OUTPUT>-ZO_RESULT = 'E'.
      CONTINUE.
    ENDIF.

    SELECT SINGLE * FROM ZGTCVMSTVAL
      INTO @DATA(LS_MSTVAL)
     WHERE MATNR = @<LS_OUTPUT>-MATNR
       AND WERKS = @<LS_OUTPUT>-WERKS.
    CLEAR: LS_VALNUM.
    LS_VALNUM-CHARACT = 'SAP_MILLCA_LENGTH_SUB'.
    IF LS_MSTVAL-PDCAPROCCODE = 'ISH'.
      LS_VALNUM-VALUE_FROM = '0'.
    ELSE.
      LS_VALNUM-VALUE_FROM = <LS_OUTPUT>-CHARG.
    ENDIF.
    APPEND LS_VALNUM TO LT_VALNUM.

    CLEAR: LS_VALNUM.
    LS_VALNUM-CHARACT = 'SAP_MILLCA_LENGTH'.
    LS_VALNUM-VALUE_FROM = <LS_OUTPUT>-CHARG.
    APPEND LS_VALNUM TO LT_VALNUM.

*- 배치 특성 업데이트(펑션 호출)
    SELECT SINGLE CUOBJ_BM
      INTO @DATA(LV_OBJKEY)
      FROM MCH1
     WHERE MATNR = @<LS_OUTPUT>-MATNR
       AND CHARG = @<LS_OUTPUT>-CHARG.
    IF SY-SUBRC NE 0.
      <LS_OUTPUT>-ZO_MESSAGE = 'Object Key(내부 오브젝트번호) 추출 실패했습니다.'.
      <LS_OUTPUT>-ZO_RESULT = 'E'.
      CONTINUE.
    ENDIF.


    CLEAR : LT_RETURN.
    CALL FUNCTION 'BAPI_OBJCL_CHANGE_KEY'
      EXPORTING
        CLOBJECTKEY         = LV_OBJKEY
        CLASSNUM            = LV_CLASS
      IMPORTING
        CLASSIF_STATUS      = LV_STATUS
      TABLES
        ALLOCVALUESNUM_NEW  = LT_VALNUM
        ALLOCVALUESCHAR_NEW = LT_VALCHAR
        ALLOCVALUESCURR_NEW = LT_VALCURR
        RETURN              = LT_RETURN.

    IF LINE_EXISTS( LT_RETURN[ TYPE = 'E' ] ).
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      <LS_OUTPUT>-ZO_MESSAGE = 'Factor 배치 특성 업데이트 실패하였습니다.'.
      <LS_OUTPUT>-ZO_RESULT = 'E'.

    ELSE.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          WAIT = 'X'.

      <LS_OUTPUT>-ZO_MESSAGE = 'Factor 배치 특성 업데이트 성공하였습니다.'.
      <LS_OUTPUT>-ZO_RESULT = 'S'.
    ENDIF.
  ENDLOOP.

*  결과처리
  MOVE-CORRESPONDING T_INPUT[] TO T_OUTPUT[].
  LOOP AT T_OUTPUT ASSIGNING <LS_OUTPUT>.
    READ TABLE LT_OUTPUT INTO DATA(LS_OUTPUT) WITH KEY MATNR = <LS_OUTPUT>-MATNR
                                                       WERKS = <LS_OUTPUT>-WERKS
                                                       CHARG = <LS_OUTPUT>-CHARG.
    IF SY-SUBRC EQ 0.
      MOVE-CORRESPONDING LS_OUTPUT TO <LS_OUTPUT>.
    ELSE.
      <LS_OUTPUT>-ZO_MESSAGE = 'Factor 배치 대상이 아닙니다.'.
      <LS_OUTPUT>-ZO_RESULT = 'E'.
    ENDIF.

  ENDLOOP.



ENDFUNCTION.
