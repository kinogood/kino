*&  Include           ZPPR1000I01                                      *
*&---------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*&      Module  EXIT_COMMAND  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
module EXIT_COMMAND input.
  ok_code = sy-ucomm.
  case ok_code.
    when 'BACK' or 'EXIT' or 'CANC'.
      perform exit_program.
  endcase.
  clear ok_code.

endmodule.                 " EXIT_COMMAND  INPUT
