FUNCTION ZGTPP_CONF_CANCEL.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(CONFIRMATION) TYPE  BAPI_PP_CONF_KEY-CONF_NO
*"     VALUE(CONFIRMATIONCOUNTER) TYPE  BAPI_PP_CONF_KEY-CONF_CNT
*"     VALUE(POSTG_DATE) TYPE  BAPI_PP_CONFIRM-POSTG_DATE
*"  EXPORTING
*"     VALUE(CREATED_CONF_NO) TYPE  BAPI_PP_CONF_KEY-CONF_NO
*"     VALUE(CREATED_CONF_COUNT) TYPE  BAPI_PP_CONF_KEY-CONF_CNT
*"     VALUE(EV_TYPE) TYPE  CHAR01
*"     VALUE(EV_MESSAGE) TYPE  ZGTPPT2460-STAT_MSG
*"----------------------------------------------------------------------

  DATA : LS_RETURN  TYPE BAPIRET1.

*- 실적 취소 펑션
  CALL FUNCTION 'BAPI_PRODORDCONF_CANCEL'
    EXPORTING
      CONFIRMATION        = CONFIRMATION "확정번호
      CONFIRMATIONCOUNTER = CONFIRMATIONCOUNTER "확정카운터
      POSTG_DATE          = POSTG_DATE
    IMPORTING
      RETURN              = LS_RETURN
      CREATED_CONF_NO     = CREATED_CONF_NO
      CREATED_CONF_COUNT  = CREATED_CONF_COUNT.
*- 실패
  IF CREATED_CONF_NO IS INITIAL.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    EV_TYPE = 'E'.
    EV_MESSAGE = LS_RETURN-MESSAGE.
*- 성공
  ELSE.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        WAIT = 'X'.
  ENDIF.

ENDFUNCTION.
