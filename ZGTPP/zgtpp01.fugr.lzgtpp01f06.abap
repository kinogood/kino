*----------------------------------------------------------------------*
***INCLUDE LZGTPP01F06.
*----------------------------------------------------------------------*
*&---------------------------------------------------------------------*
*& Form check_parameter_lot_validation
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM CHECK_PARAMETER_LOT_VALIDATION  TABLES PT_ITEM   STRUCTURE ZGTPPSIF0042
                                            PT_RETURN STRUCTURE ZGTPPSIF0043
                                      USING PV_SYSTEM_ID
                                            PV_WERKS
                                    RAISING LCX_EXCEPTION.

  CLEAR PT_RETURN[].

*// System ID 필수값 점검.
  IF PV_SYSTEM_ID IS INITIAL.
    RAISE EXCEPTION TYPE LCX_EXCEPTION MESSAGE E031 WITH TEXT-F01.
  ENDIF.

  READ TABLE ZGTPP_CL_COMMON=>GET_CODE_VALUE( IV_CODEGRP = '0010' ) INTO DATA(LS_ZGTPPT1010) WITH KEY FLD_01 = PV_SYSTEM_ID.
  IF SY-SUBRC IS INITIAL.
    PV_WERKS = LS_ZGTPPT1010-FLD_03.
  ENDIF.

  IF PV_WERKS IS INITIAL.
    RAISE EXCEPTION TYPE LCX_EXCEPTION MESSAGE E031 WITH TEXT-M53.
  ELSE.
    SELECT SINGLE @ABAP_TRUE
      INTO @DATA(LV_CHECK)
      FROM T001W
     WHERE WERKS EQ @PV_WERKS.
    IF SY-SUBRC IS NOT INITIAL.
      RAISE EXCEPTION TYPE LCX_EXCEPTION MESSAGE E011(VF) WITH PV_WERKS.
    ENDIF.
  ENDIF.

*// Import Parameter 필수 값 점검.
  IF PT_ITEM[] IS INITIAL.
    RAISE EXCEPTION TYPE LCX_EXCEPTION MESSAGE E000 WITH TEXT-M54.
  ELSE.
    PT_RETURN[] = CORRESPONDING #( PT_ITEM[] ).
  ENDIF.

  LOOP AT PT_RETURN REFERENCE INTO DATA(LR_RETURN).
    IF LR_RETURN->VBELN IS INITIAL.
      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
      MESSAGE E031 WITH TEXT-F01 INTO LR_RETURN->MESSAGE.
      CONTINUE.
    ENDIF.

    IF LR_RETURN->POSNR IS INITIAL.
      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
      MESSAGE E031 WITH TEXT-F02 INTO LR_RETURN->MESSAGE.
      CONTINUE.
    ENDIF.

    IF LR_RETURN->SEQNO IS INITIAL.
      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
      MESSAGE E031 WITH TEXT-F19 INTO LR_RETURN->MESSAGE.
    ENDIF.

    IF LR_RETURN->TAGNO IS INITIAL.
      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
      MESSAGE E031 WITH TEXT-F03 INTO LR_RETURN->MESSAGE.
    ENDIF.
  ENDLOOP.

  IF LINE_EXISTS( PT_RETURN[ STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR ] ).
    RAISE EXCEPTION TYPE LCX_EXCEPTION MESSAGE E000 WITH TEXT-M54.
  ENDIF.

ENDFORM.
*&---------------------------------------------------------------------*
*& Form lot_validation_check
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM LOT_VALIDATION_CHECK  TABLES PT_RETURN STRUCTURE ZGTPPSIF0043
                            USING PV_WERKS.
  DATA: BEGIN OF LS_LIPS_SUM,
          VBELN TYPE VBELN,
          POSNR TYPE POSNR,
          LFIMG TYPE LFIMG,
        END OF LS_LIPS_SUM.
  DATA: LT_LIPS_SUM LIKE TABLE OF LS_LIPS_SUM.
  DATA: BEGIN OF LS_LIPS,
          SEQNO LIKE ZGTPPSIF0043-SEQNO,
          VBELN TYPE VBELN,
          POSNR TYPE POSNR,
          CHARG TYPE CHARG_D,
          LFIMG LIKE LIPS-LFIMG,
          VRKME LIKE LIPS-VRKME,
        END OF LS_LIPS.
  DATA: LT_LIPS LIKE TABLE OF LS_LIPS.
  DATA LT_CONFIG TYPE TT_CONF_OUT.
  DATA LV_KALAB  TYPE MSKA-KALAB.
  DATA LV_POSNR  TYPE MSKA-POSNR.
  DATA LV_SEQNO(4) TYPE N.
  DATA LV_SMATNR TYPE MATNR.

  RANGES LR_KALAB FOR MSKA-KALAB.

  DATA(LT_RETURN) = PT_RETURN[].

*// 재고.
  WITH +ZPPT0001 AS ( SELECT DISTINCT ZT02~MATNR, ZT02~WERKS, ZT02~LGORT, ZT02~CHARG, ZT02~TAGNR
                        FROM @LT_RETURN AS ZT01
                        JOIN ZPPT0001   AS ZT02
                          ON ZT01~TAGNO EQ ZT02~TAGNR
                         AND ZT01~WERKS EQ ZT02~WERKS ),
*                       WHERE ZT02~WERKS EQ @PV_WERKS ),

       +MSKA AS ( SELECT DISTINCT MSKA~WERKS, MSKA~MATNR, MSKA~LGORT, MSKA~CHARG, +ZPPT0001~TAGNR,
                                  MSKA~VBELN, MSKA~POSNR, MSKA~KALAB
                   FROM +ZPPT0001
                   JOIN MSKA
                     ON +ZPPT0001~MATNR EQ MSKA~MATNR
                    AND +ZPPT0001~WERKS EQ MSKA~WERKS
                    AND +ZPPT0001~CHARG EQ MSKA~CHARG
                  WHERE MSKA~KALAB GT 0 ),

       +MCHB AS ( SELECT DISTINCT MCHB~WERKS, MCHB~MATNR, MCHB~LGORT, MCHB~CHARG, +ZPPT0001~TAGNR,
                                  @SPACE AS VBELN, @LV_POSNR AS POSNR, MCHB~CLABS AS KALAB
                    FROM +ZPPT0001
                    JOIN MCHB
                      ON +ZPPT0001~MATNR EQ MCHB~MATNR
                     AND +ZPPT0001~WERKS EQ MCHB~WERKS
                     AND +ZPPT0001~CHARG EQ MCHB~CHARG
                   WHERE MCHB~CLABS GT 0 )

      SELECT ZT01~WERKS, ZT01~MATNR, ZT01~LGORT, ZT01~CHARG,
             ZT01~TAGNR, ZT01~VBELN, ZT01~POSNR, ZT01~KALAB
        FROM +MSKA AS ZT01

      UNION

      SELECT ZT01~WERKS, ZT01~MATNR, ZT01~LGORT, ZT01~CHARG,
             ZT01~TAGNR, ZT01~VBELN, ZT01~POSNR, ZT01~KALAB
        FROM +MCHB AS ZT01
       ORDER BY MATNR, WERKS, LGORT, CHARG
        INTO TABLE @DATA(LT_STOCK).

*// 영업문서 품목.
  SELECT VBAP~VBELN, VBAP~POSNR, VBAP~MATNR, VBAP~CUOBJ, VBAP~KWMENG, VBAP~VRKME
    FROM @LT_RETURN AS ZT01
    JOIN VBAP
      ON ZT01~VBELN EQ VBAP~VBELN
     AND ZT01~POSNR EQ VBAP~POSNR
   ORDER BY VBAP~VBELN, VBAP~POSNR
    INTO TABLE @DATA(LT_VBAP).

*// 할당 정보.
  SELECT DISTINCT ZT01~VBELN, ZT01~POSNR, ZT01~TAGNO, ZT02~ZASSIGN_NO, ZT03~ZASSIGN_ITEM, ZT03~LGORT, ZT03~F_CHARG, ZT03~ZCUT_CNT
    FROM @LT_RETURN AS ZT01
    JOIN ZGTPPT2170 AS ZT02
      ON ZT01~VBELN EQ ZT02~VBELN
     AND ZT01~POSNR EQ ZT02~POSNR
     AND ZT02~LOEKZ EQ @SPACE
    JOIN ZGTPPT2180 AS ZT03
      ON ZT02~ZASSIGN_NO EQ ZT03~ZASSIGN_NO
   ORDER BY ZT01~VBELN, ZT01~POSNR
    INTO TABLE @DATA(LT_ALLOC_SLS).

  SELECT DISTINCT ZT02~ZASSIGN_NO, ZT02~ZASSIGN_ITEM, ZT02~LGORT, ZT02~F_CHARG, ZT02~ZCUT_CNT, ZT01~TAGNR
    FROM @LT_STOCK  AS ZT01
    JOIN ZGTPPT2180 AS ZT02
      ON ZT01~CHARG EQ ZT02~F_CHARG
    JOIN ZGTPPT2170 AS ZT03
      ON ZT02~ZASSIGN_NO EQ ZT03~ZASSIGN_NO
     AND ZT03~LOEKZ      EQ @SPACE
   ORDER BY ZT01~TAGNR
    INTO TABLE @DATA(LT_ALLOC_LOT).

*// 판매오더 품목의 Picking 정보
  CLEAR: LT_LIPS.
  SELECT DISTINCT ZT01~VBELN, ZT01~POSNR,
                  A~CHARG, A~LFIMG, A~VRKME
    FROM @LT_RETURN AS ZT01
    JOIN LIPS AS A ON A~VGBEL EQ ZT01~VBELN
                  AND A~VGPOS EQ ZT01~POSNR
                  AND A~KOSTA IN ('B', 'C')
   ORDER BY ZT01~VBELN, ZT01~POSNR
    INTO CORRESPONDING FIELDS OF TABLE @LT_LIPS.

  CLEAR: LT_LIPS_SUM, LV_SEQNO.
  LOOP AT LT_LIPS ASSIGNING FIELD-SYMBOL(<FS_LIPS>).
    MOVE-CORRESPONDING <FS_LIPS> TO LS_LIPS_SUM.
    COLLECT LS_LIPS_SUM INTO LT_LIPS_SUM.
    CLEAR: LS_LIPS_SUM.

    LV_SEQNO += 1.
    <FS_LIPS>-SEQNO = LV_SEQNO.
  ENDLOOP.

  SORT: LT_LIPS     BY VBELN POSNR SEQNO,
        LT_LIPS_SUM BY VBELN POSNR.

  LOOP AT PT_RETURN REFERENCE INTO DATA(LR_RETURN).
    READ TABLE LT_VBAP INTO DATA(LS_VBAP) WITH KEY VBELN = LR_RETURN->VBELN
                                                   POSNR = LR_RETURN->POSNR BINARY SEARCH.
    IF SY-SUBRC IS NOT INITIAL.
      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
      MESSAGE E032 WITH LR_RETURN->VBELN LR_RETURN->POSNR INTO LR_RETURN->MESSAGE.
      CONTINUE.
    ENDIF.

*// 영업문서 품목 Configuration.
    PERFORM GET_CONFIGURATION USING LS_VBAP-CUOBJ LT_CONFIG.

    NEW ZGTPP_CL_CONV( )->CONVERT_STRING_TO_QTY( EXPORTING IV_INPUT  = VALUE #( LT_CONFIG[ ATNAM = ZGTPP_IF_CONST=>GC_ATNAM-SAP_MILLCA_LENGTH ]-ATWRT OPTIONAL )
                                                 IMPORTING EV_OUTPUT = LV_KALAB ).

*    LV_KALAB = ROUND( VAL = LV_KALAB
*                      DEC = 0
*                      MODE = CL_ABAP_MATH=>ROUND_UP ).
    CLEAR: LR_KALAB, LR_KALAB[].
    LR_KALAB-SIGN = 'I'.
    LR_KALAB-OPTION = 'BT'.
    LR_KALAB-LOW = LV_KALAB - '0.5'.
    LR_KALAB-HIGH = LV_KALAB + '0.5'.
    APPEND LR_KALAB.

    READ TABLE LT_STOCK INTO DATA(LS_STOCK) WITH KEY TAGNR = LR_RETURN->TAGNO.
    IF SY-SUBRC IS NOT INITIAL.
      CLEAR LS_STOCK.
      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
      LR_RETURN->MESSAGE = TEXT-M63. "가용재고 상태가 아닙니다. 재고 상태를 확인하세요.
      CONTINUE.
    ENDIF.

*    IF LS_STOCK-MATNR NE LS_VBAP-MATNR OR   "// 자재 또는 조장 수가 다를 경우.
*       LS_STOCK-KALAB NE LV_KALAB.
*      LR_RETURN->STAT    = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
*      LR_RETURN->MESSAGE = TEXT-M51.
*      CONTINUE.
*    ENDIF.

    IF LS_STOCK-MATNR NE LS_VBAP-MATNR.
      CLEAR: LV_SMATNR.
      CALL FUNCTION 'CONVERSION_EXIT_MATN1_OUTPUT'
        EXPORTING
          INPUT  = LS_STOCK-MATNR
        IMPORTING
          OUTPUT = LV_SMATNR.

      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
      MESSAGE E043(ZGTPP00) WITH LS_VBAP-MATNR LV_SMATNR INTO LR_RETURN->MESSAGE.
      CONTINUE.
    ELSE.
*      IF LS_STOCK-KALAB NE LV_KALAB.
      IF LS_STOCK-KALAB NOT IN LR_KALAB[].
        LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
        MESSAGE E044(ZGTPP00) WITH LV_KALAB LS_STOCK-KALAB INTO LR_RETURN->MESSAGE.
        CONTINUE.
      ENDIF.
    ENDIF.

    READ TABLE LT_ALLOC_SLS INTO DATA(LS_ALLOC_SLS) WITH KEY VBELN = LR_RETURN->VBELN
                                                             POSNR = LR_RETURN->POSNR BINARY SEARCH.
    IF SY-SUBRC IS NOT INITIAL.
      CLEAR LS_ALLOC_SLS.
    ENDIF.

    READ TABLE LT_ALLOC_LOT INTO DATA(LS_ALLOC_LOT) WITH KEY TAGNR = LR_RETURN->TAGNO BINARY SEARCH.
    IF SY-SUBRC IS NOT INITIAL.
      CLEAR LS_ALLOC_LOT.
    ENDIF.

*    IF LS_ALLOC_SLS IS INITIAL AND LS_ALLOC_LOT IS NOT INITIAL. " 주문 할당이 없는 판매오더를 대상으로 다른 주문에 할당된 LOT를 SCAN하는 경우 .
*      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
*      MESSAGE E029(ZGTPP00) WITH LR_RETURN->VBELN LR_RETURN->POSNR INTO LR_RETURN->MESSAGE.
*      CONTINUE.
*    ENDIF.

    IF LS_STOCK-VBELN IS NOT INITIAL.
      IF LS_STOCK-VBELN NE LR_RETURN->VBELN OR LS_STOCK-POSNR NE LR_RETURN->POSNR.
        LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
        MESSAGE E030(ZGTPP00) WITH LR_RETURN->VBELN LR_RETURN->POSNR INTO LR_RETURN->MESSAGE.
        CONTINUE.
      ELSEIF LS_STOCK-VBELN EQ LR_RETURN->VBELN AND LS_STOCK-POSNR EQ LR_RETURN->POSNR.
        READ TABLE LT_LIPS INTO LS_LIPS WITH KEY VBELN = LR_RETURN->VBELN
                                                 POSNR = LR_RETURN->POSNR
                                                 CHARG = LS_STOCK-CHARG.
        IF SY-SUBRC EQ 0.
          LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
          LR_RETURN->MESSAGE = TEXT-M62. "이미 PICKING된 Lot입니다.
          CONTINUE.
        ENDIF.
      ENDIF.

    ELSE.
*      IF LS_ALLOC_SLS IS INITIAL AND LS_ALLOC_LOT IS NOT INITIAL. " 주문 할당이 없는 판매오더를 대상으로 다른 주문에 할당된 LOT를 SCAN하는 경우 .
*        LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
*        MESSAGE E029(ZGTPP00) WITH LR_RETURN->VBELN LR_RETURN->POSNR INTO LR_RETURN->MESSAGE.
*        CONTINUE.
*      ENDIF.

    ENDIF.

    CLEAR: LS_LIPS_SUM.
    READ TABLE LT_LIPS_SUM INTO LS_LIPS_SUM WITH KEY VBELN = LR_RETURN->VBELN
                                                     POSNR = LR_RETURN->POSNR.

    "판매오더 품목의 PICKING 수량(LIPS-LFIMG)이 판매오더 오더수량(VBAP-KWMENG)보다 같거나 큰 경우
    IF LS_LIPS_SUM-LFIMG GE LS_VBAP-KWMENG.
      LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
      MESSAGE E037(ZGTPP00) WITH LR_RETURN->VBELN LR_RETURN->POSNR INTO LR_RETURN->MESSAGE.
      CONTINUE.
    ENDIF.

    "판매오더 품목의 PICKING 수량(LIPS-LFIMG) > 0 AND 판매오더 품목의 오더수량(VBAP-KWMENG)보다 작은 경우(부분출하)
    IF LS_LIPS_SUM-LFIMG > 0 AND LS_LIPS_SUM-LFIMG < LS_VBAP-KWMENG.
      READ TABLE LT_LIPS INTO LS_LIPS WITH KEY VBELN = LR_RETURN->VBELN
                                               POSNR = LR_RETURN->POSNR
                                               SEQNO = LR_RETURN->SEQNO.
      IF SY-SUBRC EQ 0.
        LR_RETURN->STAT = ZGTPP_IF_CONST=>GC_RESULT-ERROR.
        MESSAGE E038(ZGTPP00) WITH LR_RETURN->SEQNO INTO LR_RETURN->MESSAGE.
        CONTINUE.
      ENDIF.
    ENDIF.

    LR_RETURN->STAT    = ZGTPP_IF_CONST=>GC_RESULT-SUCCESS.
    LR_RETURN->MESSAGE = TEXT-M50.
  ENDLOOP.

ENDFORM.
*&---------------------------------------------------------------------*
*& Form GET_CONFIGURATION
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM GET_CONFIGURATION  USING PV_INSTANCE PT_CONFIG TYPE TT_CONF_OUT.

  CLEAR: PT_CONFIG, PT_CONFIG[].     "2026.07.07 추가

  CALL FUNCTION 'VC_I_GET_CONFIGURATION'
    EXPORTING
      INSTANCE            = PV_INSTANCE
    TABLES
      CONFIGURATION       = PT_CONFIG
    EXCEPTIONS
      INSTANCE_NOT_FOUND  = 1
      INTERNAL_ERROR      = 2
      NO_CLASS_ALLOCATION = 3
      INSTANCE_NOT_VALID  = 4
      OTHERS              = 5.

ENDFORM.
