FUNCTION ZGTPP_CONF_CREATE_TT.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  EXPORTING
*"     VALUE(CREATED_CONF_NO) TYPE  BAPI_PP_CONF_KEY-CONF_NO
*"     VALUE(CREATED_CONF_COUNT) TYPE  BAPI_PP_CONF_KEY-CONF_CNT
*"     VALUE(EV_TYPE) TYPE  CHAR01
*"     VALUE(EV_MESSAGE) TYPE  ZGTPPT2460-STAT_MSG
*"  TABLES
*"      TIMETICKETS STRUCTURE  BAPI_PP_TIMETICKET
*"      DETAIL_RETURN STRUCTURE  BAPI_CORU_RETURN
*"----------------------------------------------------------------------

  DATA : LS_RETURN TYPE BAPIRETURN1.
  DATA : LT_DETAIL_RETURN TYPE TABLE OF BAPI_CORU_RETURN.

  CALL FUNCTION 'BAPI_PRODORDCONF_CREATE_TT'
    EXPORTING
*     POST_WRONG_ENTRIES = '1'
      TESTRUN       = ''
    IMPORTING
      RETURN        = LS_RETURN
    TABLES
      TIMETICKETS   = TIMETICKETS
      DETAIL_RETURN = LT_DETAIL_RETURN.

  READ TABLE LT_DETAIL_RETURN INTO DATA(LS_DETAIL_RETURN) WITH KEY ID = 'RU'
                                                                   NUMBER = '100'.
  IF SY-SUBRC = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        WAIT = 'X'.

    CREATED_CONF_NO = LS_DETAIL_RETURN-CONF_NO.
    CREATED_CONF_COUNT = LS_DETAIL_RETURN-CONF_CNT.

  ELSE.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

    EV_TYPE = 'E'.

    READ TABLE LT_DETAIL_RETURN INTO LS_DETAIL_RETURN WITH KEY TYPE = 'E'.

    MESSAGE ID     LS_DETAIL_RETURN-ID
            TYPE   'S'
            NUMBER LS_DETAIL_RETURN-NUMBER
            WITH   LS_DETAIL_RETURN-MESSAGE_V1
                   LS_DETAIL_RETURN-MESSAGE_V2
                   LS_DETAIL_RETURN-MESSAGE_V3
                   LS_DETAIL_RETURN-MESSAGE_V4
           INTO EV_MESSAGE.
  ENDIF.


ENDFUNCTION.
