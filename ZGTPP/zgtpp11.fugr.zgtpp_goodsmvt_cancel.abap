FUNCTION ZGTPP_GOODSMVT_CANCEL.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(MATERIALDOCUMENT) TYPE  BAPI2017_GM_HEAD_02-MAT_DOC
*"     VALUE(MATDOCUMENTYEAR) TYPE  BAPI2017_GM_HEAD_02-DOC_YEAR
*"     VALUE(GOODSMVT_PSTNG_DATE) TYPE  BAPI2017_GM_HEAD_02-PSTNG_DATE
*"     VALUE(GOODSMVT_PR_UNAME) TYPE  BAPI2017_GM_HEAD_01-PR_UNAME
*"     VALUE(DOCUMENTHEADER_TEXT) TYPE  BAPI2017_GM_HEAD_02-HEADER_TXT
*"  EXPORTING
*"     VALUE(EV_TYPE) TYPE  CHAR01
*"     VALUE(EV_MESSAGE) TYPE  ZGTPPT2460-STAT_MSG
*"     VALUE(EV_MBLNR) TYPE  MSEG-MBLNR
*"     VALUE(EV_MJAHR) TYPE  MSEG-MJAHR
*"  TABLES
*"      GOODSMVT_MATDOCITEM STRUCTURE  BAPI2017_GM_ITEM_04
*"----------------------------------------------------------------------

  DATA : LS_HEADRET TYPE BAPI2017_GM_HEAD_RET,
         LT_RETURN  TYPE TABLE OF BAPIRET2.

  CALL FUNCTION 'BAPI_GOODSMVT_CANCEL'
    EXPORTING
      MATERIALDOCUMENT    = MATERIALDOCUMENT
      MATDOCUMENTYEAR     = MATDOCUMENTYEAR
      GOODSMVT_PSTNG_DATE = GOODSMVT_PSTNG_DATE
      GOODSMVT_PR_UNAME   = GOODSMVT_PR_UNAME
      DOCUMENTHEADER_TEXT = DOCUMENTHEADER_TEXT
    IMPORTING
      GOODSMVT_HEADRET    = LS_HEADRET
    TABLES
      RETURN              = LT_RETURN
      GOODSMVT_MATDOCITEM = GOODSMVT_MATDOCITEM.

*- 실패
  IF LINE_EXISTS( LT_RETURN[ TYPE = 'E' ] ).

    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    EV_TYPE = 'E'.
    READ TABLE LT_RETURN INTO DATA(LS_RETURN) WITH KEY TYPE = 'E'.
    EV_MESSAGE = LS_RETURN-MESSAGE.

  ELSE.
*- 성공
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        WAIT = 'X'.
    EV_MBLNR = LS_HEADRET-MAT_DOC.
    EV_MJAHR = LS_HEADRET-DOC_YEAR.

  ENDIF.

ENDFUNCTION.
