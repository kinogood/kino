FUNCTION Z_TI_GET_INSURANCE_POL.
*"----------------------------------------------------------------------
*"*"Local interface:
*"  IMPORTING
*"     REFERENCE(IIPNO) TYPE  ZTIIIPNO
*"     REFERENCE(AMDSQ) TYPE  ZTIAMSEQ OPTIONAL
*"  EXPORTING
*"     REFERENCE(ZTITIP1) TYPE  ZTITIP1
*"     VALUE(ZTITIP3) TYPE  ZTITIP3
*"     VALUE(ZTITIP4) TYPE  ZTITIP4
*"     VALUE(ZTITRQK) TYPE  ZTITRQK
*"  TABLES
*"      ZTITRQP STRUCTURE  ZTISRQIT OPTIONAL
*"      ZTITIP2 STRUCTURE  ZTISIP02 OPTIONAL
*"  EXCEPTIONS
*"      NOT_FOUND
*"----------------------------------------------------------------------

  CLEAR: ZTITIP1, ZTITIP3, ZTITRQK, ZTITIP4.
  REFRESH: ZTITRQP, ZTITIP2.

*> I/P Table
  SELECT SINGLE *
    FROM ZTITIP1
   WHERE IIPNO = IIPNO
     AND AMDSQ = AMDSQ.

  IF SY-SUBRC  NE  0.
    MESSAGE E156 WITH IIPNO RAISING NOT_FOUND.
  ENDIF.

*> I/P 배서 Table
  SELECT SINGLE *
    FROM ZTITIP4
   WHERE IIPNO = IIPNO
     AND AMDSQ = AMDSQ.

* 부가조건.
  SELECT * INTO CORRESPONDING FIELDS OF TABLE ZTITIP2
    FROM ZTITIP2
   WHERE IIPNO  EQ IIPNO
     AND AMDSQ  EQ AMDSQ.

*> I/P 구상관리 Table
  IF NOT ZTITIP1-DAMAG IS INITIAL.
    SELECT SINGLE *
      INTO ZTITIP3
      FROM ZTITIP3
     WHERE IIPNO = IIPNO.
  ENDIF.

* 수입의뢰 item.
  IF ZTITIP1-REQNO IS INITIAL.
    IF ZTITIP1-IBLNO IS INITIAL.
      IF NOT ZTITIP1-EBELN IS INITIAL.
        SELECT * INTO CORRESPONDING FIELDS OF TABLE ZTITRQP
          FROM EKPO
         WHERE EBELN EQ ZTITIP1-EBELN.

        LOOP AT ZTITRQP.
          ZTITRQP-RQMNG = ZTITRQP-MENGE.
          SELECT SINGLE STAWN
          INTO ZTITRQP-STAWN
          FROM MARC
         WHERE MATNR EQ ZTITRQP-MATNR
           AND WERKS EQ ZTITRQP-WERKS.
          MODIFY ZTITRQP.
        ENDLOOP.
      ENDIF.
    ELSE.
      SELECT *
        FROM ZTITBLP
       WHERE IBLNO  EQ ZTITIP1-IBLNO.

        MOVE-CORRESPONDING ZTITBLP TO ZTITRQP.
        MOVE : ZTITBLP-BLMNG TO ZTITRQP-RQMNG.

        SELECT SINGLE MENGE WERKS LGORT MATNR TXZ01
                      LOEKZ ELIKZ BPRME BPUMZ BPUMN UMREZ
                      UMREN NETPR PEINH UEBTO UEBTK UNTTO
        INTO CORRESPONDING FIELDS OF ZTITRQP
          FROM EKPO
         WHERE EBELN  EQ  ZTITRQP-EBELN
           AND EBELP  EQ  ZTITRQP-EBELP.
        APPEND ZTITRQP.
      ENDSELECT.
    ENDIF.
  ELSE.
*> 수입의뢰.
    SELECT SINGLE *
      FROM ZTITRQK
     WHERE REQNO  EQ ZTITIP1-REQNO.

    IF SY-SUBRC  NE  0.
      MESSAGE W108 WITH ZTITIP1-REQNO RAISING NOT_FOUND.
    ENDIF.

    IF ZTITIP1-IBLNO IS INITIAL.
      SELECT * INTO CORRESPONDING FIELDS OF TABLE ZTITRQP
        FROM ZTIVRQ00
       WHERE REQNO  EQ ZTITIP1-REQNO.

      LOOP AT ZTITRQP.
        IF NOT ZTITRQP-EBELN IS INITIAL.
          SELECT SINGLE MENGE WERKS LGORT MATNR TXZ01
                        LOEKZ ELIKZ BPRME BPUMZ BPUMN UMREZ
                        UMREN NETPR PEINH UEBTO UEBTK UNTTO
          INTO CORRESPONDING FIELDS OF ZTITRQP
            FROM EKPO
           WHERE EBELN  EQ  ZTITRQP-EBELN
             AND EBELP  EQ  ZTITRQP-EBELP.

*        SELECT  SUM( rqmng ) INTO ZTITRQP-rqmngs FROM ZTIvrq00
*         WHERE  ebeln  EQ  ZTITRQP-ebeln
*           AND  ebelp  EQ  ZTITRQP-ebelp
*           AND NOT ( reqno  EQ  ZTITRQP-reqno
*           AND       reqit  EQ  ZTITRQP-reqit ).
*
*        ZTITRQP-rqmngl =  ZTITRQP-menge - ZTITRQP-rqmngs.
*        IF ZTITRQP-rqmngl LE 0.
*          ZTITRQP-rqmngl = 0.
*        ENDIF.
        ENDIF.
        MODIFY ZTITRQP.
      ENDLOOP.
    ELSE.
      SELECT *
        FROM ZTITBLP
       WHERE IBLNO  EQ ZTITIP1-IBLNO.

        MOVE-CORRESPONDING ZTITBLP TO ZTITRQP.
        MOVE : ZTITBLP-BLMNG TO ZTITRQP-RQMNG.

        SELECT SINGLE MENGE WERKS LGORT MATNR TXZ01
                      LOEKZ ELIKZ BPRME BPUMZ BPUMN UMREZ
                      UMREN NETPR PEINH UEBTO UEBTK UNTTO
        INTO CORRESPONDING FIELDS OF ZTITRQP
          FROM EKPO
         WHERE EBELN  EQ  ZTITRQP-EBELN
           AND EBELP  EQ  ZTITRQP-EBELP.
        APPEND ZTITRQP.
      ENDSELECT.
    ENDIF.
  ENDIF.

ENDFUNCTION.
