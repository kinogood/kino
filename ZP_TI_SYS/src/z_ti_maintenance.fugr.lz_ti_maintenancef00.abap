*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZTIVCRK.........................................*
FORM GET_DATA_ZTIVCRK.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZTITCRK WHERE
(VIM_WHERETAB) .
    CLEAR ZTIVCRK .
ZTIVCRK-MANDT =
ZTITCRK-MANDT .
ZTIVCRK-ICCNO =
ZTITCRK-ICCNO .
ZTIVCRK-ICCSQ =
ZTITCRK-ICCSQ .
ZTIVCRK-CFNST =
ZTITCRK-CFNST .
ZTIVCRK-DOCST =
ZTITCRK-DOCST .
ZTIVCRK-SNDST =
ZTITCRK-SNDST .
<VIM_TOTAL_STRUC> = ZTIVCRK.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZTIVCRK .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZTIVCRK.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZTIVCRK-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZTITCRK WHERE
  ICCNO = ZTIVCRK-ICCNO AND
  ICCSQ = ZTIVCRK-ICCSQ .
    IF SY-SUBRC = 0.
    DELETE ZTITCRK .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZTITCRK WHERE
  ICCNO = ZTIVCRK-ICCNO AND
  ICCSQ = ZTIVCRK-ICCSQ .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZTITCRK.
    ENDIF.
ZTITCRK-MANDT =
ZTIVCRK-MANDT .
ZTITCRK-ICCNO =
ZTIVCRK-ICCNO .
ZTITCRK-ICCSQ =
ZTIVCRK-ICCSQ .
ZTITCRK-CFNST =
ZTIVCRK-CFNST .
ZTITCRK-DOCST =
ZTIVCRK-DOCST .
ZTITCRK-SNDST =
ZTIVCRK-SNDST .
    IF SY-SUBRC = 0.
    UPDATE ZTITCRK .
    ELSE.
    INSERT ZTITCRK .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZTIVCRK-UPD_FLAG,
STATUS_ZTIVCRK-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
*---------------------------------------------------------------------*
FORM READ_SINGLE_ENTRY_ZTIVCRK.
  SELECT SINGLE * FROM ZTITCRK WHERE
ICCNO = ZTIVCRK-ICCNO AND
ICCSQ = ZTIVCRK-ICCSQ .
ZTIVCRK-MANDT =
ZTITCRK-MANDT .
ZTIVCRK-ICCNO =
ZTITCRK-ICCNO .
ZTIVCRK-ICCSQ =
ZTITCRK-ICCSQ .
ZTIVCRK-CFNST =
ZTITCRK-CFNST .
ZTIVCRK-DOCST =
ZTITCRK-DOCST .
ZTIVCRK-SNDST =
ZTITCRK-SNDST .
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZTIVCRK USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZTIVCRK-ICCNO TO
ZTITCRK-ICCNO .
MOVE ZTIVCRK-ICCSQ TO
ZTITCRK-ICCSQ .
MOVE ZTIVCRK-MANDT TO
ZTITCRK-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZTITCRK'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZTITCRK TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZTITCRK'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
